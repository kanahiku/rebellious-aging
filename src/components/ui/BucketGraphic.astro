---
/**
 * BucketGraphic — reusable three-bucket diagram with cascading pour animation.
 *
 * Based on the supplied buckets.html reference. Tokens only; no hardcoded hex.
 */
import Button from '~/components/ui/Button.astro';
import BucketCascade from '~/components/ui/bucket/BucketCascade.astro';
import BucketOne from '~/components/ui/bucket/BucketOne.astro';
import BucketTwo from '~/components/ui/bucket/BucketTwo.astro';
import BucketThree from '~/components/ui/bucket/BucketThree.astro';
import BucketSpill from '~/components/ui/bucket/BucketSpill.astro';

export interface Props {
  cta?: { text: string; href: string };
  class?: string;
}

const { cta, class: className = '' } = Astro.props;
---


<div class:list={['bucket-graphic', className]} data-bucket-graphic>
  {
    cta && (
      <div class="bucket-graphic__cta-row">
        <div class="bucket-graphic__cta-col">
          <Button variant="primary" text={cta.text} href={cta.href} hideNote class="bucket-graphic__cta" />
          <svg class="bucket-graphic__cta-pour bucket-graphic__pour" viewBox="0 0 14 56" aria-hidden="true">
            <path
              d="M 7 0 L 7 46"
              fill="none"
              stroke="var(--aw-color-secondary)"
              stroke-width="6"
              stroke-linecap="round"
            />
            <path
              class="bucket-graphic__flow"
              d="M 7 0 L 7 46"
              fill="none"
              stroke="var(--aw-color-bg-feature-card)"
              stroke-width="2.5"
              stroke-linecap="round"
            />
            <circle class="bucket-graphic__drop" cx="2" cy="50" r="2" fill="var(--aw-color-secondary)" />
            <circle
              class="bucket-graphic__drop bucket-graphic__drop--delay"
              cx="12"
              cy="51"
              r="1.7"
              fill="var(--aw-color-secondary)"
            />
          </svg>
        </div>
      </div>
    )
  }

  <div class="bucket-graphic__row">
    <BucketCascade />
    <BucketOne />
    <BucketSpill variant="one" d="M -18 1 C 8 -42, 62 -32, 92 59" dropY={51} />
    <BucketTwo />
    <BucketSpill variant="two" d="M -18 66 C 8 23, 62 33, 92 124" dropY={116} />
    <BucketThree />
  </div>
</div>

<script>
  import '~/scripts/bucket-graphic';
</script>
