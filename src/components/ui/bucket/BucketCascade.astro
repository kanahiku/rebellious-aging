---
/** Animated cascade of pour streams behind the three buckets. */
---

<svg class="bucket-graphic__cascade bucket-graphic__pour" aria-hidden="true">
  <g class="bucket-graphic__stream">
    <path
      class="bucket-graphic__base"
      fill="none"
      stroke="var(--aw-color-secondary)"
      stroke-width="6"
      stroke-linecap="round"></path>
    <g class="bucket-graphic__tail">
      <path
        class="bucket-graphic__flow"
        fill="none"
        stroke="var(--aw-color-bg-feature-card)"
        stroke-width="2.5"
        stroke-linecap="round"></path>
      <circle class="bucket-graphic__drop" r="2.2" fill="var(--aw-color-secondary)"></circle>
      <circle class="bucket-graphic__drop bucket-graphic__drop--delay" r="1.8" fill="var(--aw-color-secondary)"
      ></circle>
    </g>
  </g>
  <g class="bucket-graphic__stream">
    <path
      class="bucket-graphic__base"
      fill="none"
      stroke="var(--aw-color-secondary)"
      stroke-width="6"
      stroke-linecap="round"></path>
    <g class="bucket-graphic__tail">
      <path
        class="bucket-graphic__flow"
        fill="none"
        stroke="var(--aw-color-bg-feature-card)"
        stroke-width="2.5"
        stroke-linecap="round"></path>
      <circle class="bucket-graphic__drop" r="2.2" fill="var(--aw-color-secondary)"></circle>
      <circle class="bucket-graphic__drop bucket-graphic__drop--delay" r="1.8" fill="var(--aw-color-secondary)"
      ></circle>
    </g>
  </g>
</svg>
