---
export interface Props {
  variant: 'one' | 'two';
  /** SVG path for the spill stream. */
  d: string;
  /** Y position of the first falling drop. */
  dropY: number;
}

const { variant, d, dropY } = Astro.props;
---

<div class={`bucket-graphic__spill bucket-graphic__spill--${variant}`}>
  <svg class="bucket-graphic__pour" viewBox="0 0 64 140" aria-hidden="true">
    <path
      d={d}
      fill="none"
      stroke="var(--aw-color-secondary)"
      stroke-width="6"
      stroke-linecap="round"></path>
    <path
      class="bucket-graphic__flow"
      d={d}
      fill="none"
      stroke="var(--aw-color-bg-feature-card)"
      stroke-width="2.5"
      stroke-linecap="round"></path>
    <circle class="bucket-graphic__drop" cx="84" cy={dropY} r="2.2" fill="var(--aw-color-secondary)"></circle>
    <circle
      class="bucket-graphic__drop bucket-graphic__drop--delay"
      cx="100"
      cy={dropY + 2}
      r="1.8"
      fill="var(--aw-color-secondary)"></circle>
  </svg>
  <span class="bucket-graphic__word">spills<br /> over</span>
</div>
