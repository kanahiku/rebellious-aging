---
export interface Props {
  visualSubheading?: string;
  subtitle: string;
}

const { visualSubheading, subtitle } = Astro.props;
const paragraphs = subtitle
  .split(/\n\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

{
  visualSubheading && (
    <span class="block font-normal font-heading text-heading mb-6 leading-[130%] tracking-tight" style="font-size: clamp(1.25rem, 0.376vw + 1.109rem, 1.5rem)">
      {visualSubheading}
    </span>
  )
}
{
  paragraphs.map((paragraph, index) => (
    <>
      {index > 0 && (
        <>
          <br />
          <br />
        </>
      )}
      {paragraph}
    </>
  ))
}
