---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RemoteImage from '~/components/common/Image.astro';

export interface Props {
  image?: ImageMetadata;
  /** CMS image URL (Sanity CDN). Used instead of `image` when set. */
  imageSrc?: string;
  alt: string;
  id?: string;
  aspectRatio?: string;
}

const { image, imageSrc, alt, id, aspectRatio = '1440 / 511' } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full py-8 md:py-16">
  {imageSrc ? (
    <RemoteImage
      src={imageSrc}
      alt={alt}
      class="w-full object-cover"
      style={`aspect-ratio: ${aspectRatio}; object-position: center center;`}
      layout="none"
      widths={[640, 828, 1200, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={82}
      loading="lazy"
      decoding="async"
    />
  ) : image ? (
  <Image
    src={image}
    alt={alt}
    class="w-full object-cover"
    style={`aspect-ratio: ${aspectRatio}; object-position: center center;`}
    widths={[640, 828, 1200, 1440, 1920]}
    sizes="100vw"
    format="webp"
    quality={82}
    loading="lazy"
    decoding="async"
  />
  ) : null}
</section>
