---
/**
 * AthenaEvaluationBooking — own-doctor alternative + sponsor disclosure/booking CTA.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';

export interface Props {
  id?: string;
  heading: string;
  body: string;
  listLinkText: string;
  listLinkHref: string;
  disclosureEyebrow: string;
  disclosureText: string;
  ctaText: string;
  ctaHref: string;
  note: string;
}

const { id, heading, body, listLinkText, listLinkHref, disclosureEyebrow, disclosureText, ctaText, ctaHref, note } =
  Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full bg-cta">
  <div class="mx-auto w-full max-w-container px-5 py-12 sm:px-8 md:px-16 md:py-[64px] lg:px-[120px] lg:py-[120px]">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-[120px]">
      <div class="flex min-w-0 flex-col">
        <Heading variant="h2">{heading}</Heading>
        <Text class="mt-4">{body}</Text>
        <a href={listLinkHref} class="btn-link mt-5">{listLinkText}</a>
      </div>

      <div class="flex min-w-0 flex-col items-start">
        <div class="w-full rounded-[32px] bg-surface p-6 md:p-8">
          <Heading variant="eyebrow">{disclosureEyebrow}</Heading>
          <Text class="mt-4">{disclosureText}</Text>
        </div>
        <Button
          variant="primary"
          text={ctaText}
          href={ctaHref}
          target="_blank"
          hideNote
          class="mt-6 self-start"
        />
        <Text variant="small" class="mt-4">{note}</Text>
      </div>
    </div>
  </div>
</section>
