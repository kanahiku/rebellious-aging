---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash } from '~/utils/permalinks';
import HeaderEmbedded from './header/HeaderEmbedded.astro';
import HeaderDesktopNav from './header/HeaderDesktopNav.astro';
import HeaderActions from './header/HeaderActions.astro';
import HeaderMobilePanel from './header/HeaderMobilePanel.astro';
import type { NavLink } from './header/types';
import type { CallToAction } from '~/types';

export interface Props {
  id?: string;
  links?: NavLink[];
  actions?: Array<CallToAction>;
  phone?: { text: string; href: string };
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showRssFeed?: boolean;
  position?: string;
  /** Render only the glass nav bar, for use inside an overlay hero. */
  embedded?: boolean;
}

const {
  id = 'header',
  links = [],
  actions = [],
  phone,
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showRssFeed = false,
  position = 'center',
  embedded = false,
} = Astro.props;

const extraActions = (actions ?? []).filter(
  (action) => action.href !== phone?.href && !String(action.href ?? '').startsWith('tel:')
);
const phoneAction = phone
  ? { variant: 'primary' as const, text: phone.text, href: phone.href, icon: 'tabler:phone' }
  : undefined;
const phoneLabel = phone ? `Call ${phone.text}` : '';
const phoneBoxClass =
  'inline-flex items-center justify-center shrink-0 size-9 rounded-md bg-accent text-black border-2 border-accent hover:bg-accent-hover hover:border-accent-hover transition duration-200';

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

---
<aw-header transition:persist={embedded ? 'hero-nav' : 'header'}>
  {
    embedded ? (
      <HeaderEmbedded id={id} links={links} extraActions={extraActions} currentPath={currentPath} />
    ) : (
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0 bg-section-dark"></div>
    <div
      class:list={[
        'relative text-white py-2 px-3 md:py-3 md:px-6 mx-auto w-full flex items-center justify-between',
        {
          'max-w-container': !isFullWidth,
        },
      ]}
    >
      <div class="flex items-center justify-between w-full md:w-auto">
        <a class="flex items-center min-w-0" href={getHomePermalink()}>
          <Logo class="h-5 max-w-[140px] md:h-9 md:max-w-[240px]" />
        </a>
        <div class="flex items-center gap-2 md:hidden">
          {
            phone && (
              <a href={phone.href} class={phoneBoxClass} aria-label={phoneLabel}>
                <Icon name="tabler:phone" class="size-4" aria-hidden="true" />
              </a>
            )
          }
          <ToggleMenu class="flex size-10 flex-col items-center justify-center rounded-lg bg-white/10 cursor-pointer group" />
        </div>
      </div>
      <HeaderDesktopNav links={links} currentPath={currentPath} />
      <HeaderActions showRssFeed={showRssFeed} phoneAction={phoneAction} extraActions={extraActions} />
    </div>

      <HeaderMobilePanel links={links} currentPath={currentPath} phoneAction={phoneAction} extraActions={extraActions} />
  </header>
    )
  }
</aw-header>

<script>
  import '~/scripts/header';
</script>
