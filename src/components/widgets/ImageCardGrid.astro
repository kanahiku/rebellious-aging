---
/**
 * ImageCardGrid — 3-col grid of image-topped cards (Figma node 310:1319, The Ohana page).
 * Blue Zones / connection pillar cards: image + eyebrow + h3 + body. No CTA.
 *
 * Visual spec (from Figma):
 *   bg-page, NO top padding (follows directly after the editorial image), pb-[64px].
 *   3-col gap-[32px] grid.
 *   Card: bg-white, rounded-[16px], shadow-[4px_4px_30px_0px_rgba(0,0,0,0.05)],
 *         overflow-hidden.
 *   Image: top of card, aspect from Figma (2070/1380 ≈ 3/2), full-width.
 *   Text block: p-[16px], gap-[16px] — eyebrow (#567f9b, 12px, uppercase, tracking)
 *               → h3 (#2c4a5b, 28px Fraunces) → body (#45555d, 14px).
 *   Optional footer note: centered muted small text below the grid.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface ImageCardItem {
  eyebrow: string;
  heading: string;
  body: string;
  /** CSS aspect-ratio string, e.g. "2070 / 1380". Defaults to 2070/1380. */
  imageAspect?: string;
  /** Real image — pass the Astro-imported ImageMetadata object */
  image?: ImageMetadata;
  /** Alt text for the image */
  imageAlt?: string;
}

export interface Props {
  cards: ImageCardItem[];
  footerNote?: string;
  id?: string;
}

const { cards = [], footerNote, id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full bg-page pb-12 lg:pb-[64px]">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">

    <div class="grid grid-cols-1 gap-[32px] md:grid-cols-3">
      {cards.map((card) => (
        <div class="flex flex-col overflow-hidden rounded-[16px] bg-white shadow-[4px_4px_30px_0px_rgba(0,0,0,0.05)]">
          {card.image ? (
            <Image
              src={card.image}
              alt={card.imageAlt ?? ''}
              class="w-full shrink-0 object-cover"
              style={`aspect-ratio: ${card.imageAspect ?? '2070 / 1380'};`}
              widths={[400, 540, 720]}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 33vw, 380px"
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="w-full shrink-0 bg-section-grey"
              style={`aspect-ratio: ${card.imageAspect ?? '2070 / 1380'};`}
              aria-hidden="true"
            />
          )}
          <div class="flex flex-col gap-4 p-4">
            <p class="font-sans text-[12px] uppercase tracking-[0.06em] text-accent">
              {card.eyebrow}
            </p>
            <h3 class="font-heading text-[28px] leading-[1.2] text-primary">
              {card.heading}
            </h3>
            <p class="font-sans text-[14px] leading-[1.45] text-muted">{card.body}</p>
          </div>
        </div>
      ))}
    </div>

    {footerNote && (
      <p class="mt-8 text-center text-[14px] leading-[1.3] text-muted">{footerNote}</p>
    )}

  </div>
</section>
