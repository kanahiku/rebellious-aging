---
/**
 * ConceptCards — 4-up row of Card variant="pillar" with no section header.
 * Supports optional icons per card (Figma node 64:845 — Four Pillars page).
 *
 * Visual spec:
 *   bg-page, px-[120px], no extra vertical padding (padding controlled by the wrapper section).
 *   4 equal columns, gap-[32px], items stretch to the tallest card.
 *   Each card: optional icon tile (50×50, bg-section-grey, rounded-bl-[12px])
 *              + label eyebrow + 28px Fraunces title + 12px body.
 *
 * Content is passed from the page file — never baked in.
 */
import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface ConceptCardItem {
  label: string;
  title: string;
  description: string;
  /** Full SVG markup string for the icon. 20×20 icon path without built-in bg. */
  iconSvg?: string;
  /**
   * When true, wraps the icon in a bg tile (rounded-bl-[12px] tile).
   * Use iconBgClass to control the tile colour.
   */
  iconBg?: boolean;
  /**
   * Tailwind class for the icon tile background.
   * Defaults to 'bg-section-grey' (blue-grey) — correct for cards on a white page.
   * Pass 'bg-cta' for tan background (homepage pillars).
   */
  iconBgClass?: string;
}

export interface Props {
  cards: ConceptCardItem[];
  id?: string;
}

const { cards = [], id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full">
  <div class="mx-auto grid w-full max-w-container grid-cols-1 gap-8 px-5 py-10 sm:grid-cols-2 sm:px-8 md:px-16 md:py-16 lg:grid-cols-4 lg:px-[120px] lg:pt-[120px] lg:pb-[64px]">
    {cards.map((card) => (
      <Card
        variant="pillar"
        surface="white"
        label={card.label}
        iconBg={card.iconBg ?? false}
        iconBgClass={card.iconBgClass ?? 'bg-section-grey'}
        class="h-full"
      >
        {card.iconSvg && (
          <Fragment slot="icon" set:html={card.iconSvg} />
        )}
        <Heading variant="h4" color="inherit" class="text-primary flex-1" as="p">
          {card.title}
        </Heading>
        <Text variant="small" class="mt-auto">{card.description}</Text>
      </Card>
    ))}
  </div>
</section>
