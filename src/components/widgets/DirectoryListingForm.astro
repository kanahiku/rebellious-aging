---
/**
 * DirectoryListingForm — the "List a business" form from the client's directory mockup
 * (12 fields, category select, free-listing note).
 *
 * Renders as a single centred modal-style card (same look as the /form self-assessment card),
 * one step, no hero. The × closes back to /directory.
 * Submits to the shared forms Worker (Turnstile + honeypot), which emails the client.
 * Fields are config-driven (same shape as the mockup's BIZ_FIELDS).
 */

interface Field {
  n: string;
  l: string;
  req?: boolean;
  ta?: boolean;
  type?: 'text' | 'email' | 'tel';
  hint?: string;
  sel?: string[];
}

export interface Props {
  id?: string;
  kind?: 'business';
  /** Options for the business "Which list does it belong in?" select. Falls back to the mockup's list. */
  categoryOptions?: string[];
}

import { FORM_ENDPOINT, TURNSTILE_SITE_KEY, SITE_SLUG } from '~/lib/forms';

const { id = 'listing-form', kind = 'business', categoryOptions } = Astro.props;

const BIZ_FIELDS: Field[] = [
  { n: 'bizName', l: 'Business or organisation name', req: true },
  {
    n: 'category',
    l: 'Which list does it belong in?',
    req: true,
    sel: categoryOptions?.length
      ? [...categoryOptions, 'Not sure']
      : ['Groups & Ohana', 'Exercise', 'Diet', 'Sleep', 'Ask your doctor', 'Service', 'Not sure'],
  },
  {
    n: 'what',
    l: 'What do you offer?',
    ta: true,
    req: true,
    hint: 'What someone over 50 would actually come to you for.',
  },
  { n: 'where', l: 'Address', req: true },
  { n: 'hours', l: 'Hours or how to book' },
  {
    n: 'cost',
    l: 'Typical price',
    hint: 'A range is fine. We list prices where we can. People want to know before they call.',
  },
  { n: 'link', l: 'Website', req: true },
  { n: 'contactName', l: 'Your name', req: true },
  { n: 'role', l: 'Your role' },
  { n: 'email', l: 'Your email', req: true, type: 'email' },
  { n: 'phone', l: 'Your phone', type: 'tel' },
  { n: 'notes', l: 'Anything else?', ta: true },
];

const fields = BIZ_FIELDS;

const businessNote =
  'Listings are free and we choose them ourselves. Submitting does not buy you a place, and we do not list anything we cannot verify. If you want to sponsor a page, say so in the notes and we will send you the rates separately.';

const control =
  'w-full rounded-[12px] border border-primary/15 bg-page px-4 py-3 font-sans text-[15px] text-heading placeholder:text-muted/40 transition-colors focus:border-primary/40 focus:outline-none';
---

<section
  {id}
  class="not-prose flex min-h-screen w-full items-start justify-center bg-page px-4 py-8 sm:items-center sm:px-6 sm:py-12"
>
  <div
    role="dialog"
    aria-modal="false"
    aria-labelledby={`${id}-title`}
    class="relative w-full max-w-[620px] rounded-[32px] border border-primary/15 bg-surface p-6 sm:p-10"
  >
    <a
      href="/directory"
      aria-label="Close and go back to the directory"
      class="absolute right-4 top-4 flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-section-grey hover:text-heading sm:right-6 sm:top-6"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </a>

    <h1 id={`${id}-title`} class="font-heading text-h3 font-normal leading-[1.1] text-heading">List a business</h1>

    <p class="mt-6 rounded-[12px] bg-section-grey p-4 font-sans text-[14px] leading-[1.45] text-muted">
      {businessNote}
    </p>

    <form
      class="listing-form mt-8 flex flex-col gap-5"
      data-kind={kind}
      data-endpoint={FORM_ENDPOINT}
      data-slug={SITE_SLUG}
      data-sitekey={TURNSTILE_SITE_KEY}
      novalidate
    >
      {/* Honeypot: invisible to real users */}
      <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="listing-form-turnstile empty:hidden"></div>
      {
        fields.map((f) => {
          const fid = `${id}-${f.n}`;
          return (
            <div class="flex flex-col gap-1.5">
              <label for={fid} class="font-sans text-[14px] font-semibold leading-[1.3] text-heading">
                {f.l}
                {f.req && (
                  <span class="text-accent" aria-hidden="true">
                    {' '}
                    *
                  </span>
                )}
              </label>
              {f.hint && <span class="font-sans text-[13px] leading-[1.4] text-muted">{f.hint}</span>}
              {f.sel ? (
                <select id={fid} name={f.n} required={f.req} class={`${control} select-arrow`}>
                  <option value="">Choose one</option>
                  {f.sel.map((o) => (
                    <option>{o}</option>
                  ))}
                </select>
              ) : f.ta ? (
                <textarea id={fid} name={f.n} required={f.req} rows="4" class={`${control} resize-y`} />
              ) : (
                <input id={fid} name={f.n} type={f.type ?? 'text'} required={f.req} class={control} />
              )}
            </div>
          );
        })
      }

      <p class="listing-form-error hidden font-sans text-[14px] font-semibold text-red-600" role="alert">
        We could not send that just now. Please try again in a moment.
      </p>

      <button type="submit" class="btn-primary mt-2 w-full">Send it in</button>
    </form>

    <div class="listing-form-success mt-8 hidden flex-col gap-4" role="status">
      <h2 class="font-heading text-h4 font-normal text-heading">Thank you. We have it.</h2>
      <p class="font-sans text-body leading-[1.45] text-muted">
        A person reads every submission and will email you before anything is listed. Nothing is published
        automatically.
      </p>
      <a href="/directory" class="btn-link self-start">Back to the directory</a>
    </div>
  </div>
</section>

<script>
  // Sends the submission through the shared forms Worker (same one as the Ohana contact form),
  // which emails the client. Nothing is stored in Sanity.
  interface TurnstileApi {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    execute: (id: string) => void;
    reset: (id: string) => void;
  }
  const getTurnstile = () => (window as unknown as { turnstile?: TurnstileApi }).turnstile;

  const LABELS: Record<string, string> = {
    bizName: 'Business name',
    category: 'List',
    what: 'What they offer',
    where: 'Address',
    hours: 'Hours / booking',
    cost: 'Typical price',
    link: 'Website',
    contactName: 'Contact name',
    role: 'Role',
    email: 'Contact email',
    phone: 'Contact phone',
    notes: 'Notes',
  };

  document.querySelectorAll<HTMLFormElement>('form.listing-form').forEach((form) => {
    const endpoint = form.dataset.endpoint!;
    const slug = form.dataset.slug!;
    const sitekey = form.dataset.sitekey!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const errorEl = form.querySelector<HTMLElement>('.listing-form-error')!;
    const successEl = form.parentElement!.querySelector<HTMLElement>('.listing-form-success')!;
    const tsBox = form.querySelector<HTMLElement>('.listing-form-turnstile')!;

    let tsToken = '';
    let widgetId = '';

    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.onload = () => {
      const w = getTurnstile();
      widgetId = w!.render(tsBox, {
        sitekey,
        action: slug,
        appearance: 'interaction-only',
        callback: (t: string) => (tsToken = t),
        'expired-callback': () => (tsToken = ''),
        'error-callback': () => (tsToken = ''),
      });
    };
    document.head.appendChild(script);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();

      if (!tsToken) {
        const w = getTurnstile();
        if (w && widgetId) w.execute(widgetId);
        await new Promise<void>((resolve) => {
          const deadline = Date.now() + 12_000;
          const poll = () => (tsToken || Date.now() > deadline ? resolve() : setTimeout(poll, 150));
          poll();
        });
      }

      const lines = Object.keys(LABELS)
        .map((k) => (get(k) ? `${LABELS[k]}: ${get(k)}` : ''))
        .filter(Boolean);
      const message = [`LIST A BUSINESS: ${get('bizName')}`, '', ...lines].join('\n');

      submitBtn.disabled = true;
      const label = submitBtn.textContent;
      submitBtn.textContent = 'Sending…';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            site: slug,
            name: get('contactName'),
            email: get('email'),
            // The shared Worker requires a valid phone; use a placeholder when left blank.
            phone: get('phone') || '0000000000',
            message,
            website: get('website'),
            turnstileToken: tsToken,
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        form.reset();
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
        successEl.classList.add('flex');
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = label;
        const w = getTurnstile();
        if (w && widgetId) w.reset(widgetId);
        tsToken = '';
      }
    });
  });
</script>
