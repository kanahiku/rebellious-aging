---
/**
 * EverythingPeaks — gradient-card section (Figma node 2:229 and recurrences).
 *
 * Visual spec (Figma 2:229):
 *   Outer: bg-page, px-[120px] py-[64px].
 *   Inner card: bg-gradient-to-t from-transparent to-section-grey,
 *               rounded-tl-[64px] rounded-tr-[64px], p-[64px], flex-col, gap-[64px].
 *
 *   TOP ROW — 2 equal columns, gap-[32px], items-start:
 *     LEFT  flex-1 — eyebrow + h2 heading
 *     RIGHT flex-1 — body slot + primary CTA button (stacked, gap-[32px])
 *
 *   BOTTOM — full-width image slot, aspect 1695/928, rounded-[32px]
 *
 * Usage:
 *   <EverythingPeaks
 *     eyebrow="Why any of this is urgent"
 *     headingHtml="Everything peaks.<br/>Then it <span class='text-accent'>slopes.</span>"
 *     cta={{ text: "Understand the model", href: "/how-aging-works" }}
 *   >
 *     <Fragment slot="body">
 *       <Text>First paragraph…</Text>
 *       <Text class="mt-[1lh]">Second paragraph…</Text>
 *     </Fragment>
 *     <img slot="image" src={…} … />
 *   </EverythingPeaks>
 *
 * Props:
 *   eyebrow     — optional eyebrow label
 *   heading     — plain-text heading
 *   headingHtml — HTML heading (takes precedence; supports inline accent spans)
 *   cta         — optional { text, href } for the primary CTA button
 *   id          — section anchor id
 */

import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  headingHtml?: string;
  cta?: { text: string; href: string };
  id?: string;
}

const { eyebrow, heading, headingHtml, cta, id } = Astro.props;

const hasImage = Astro.slots.has('image');
---

<section {...id ? { id } : {}} class="not-prose w-full py-8 md:py-[64px]">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">

    {/* Inner card — gradient top-rounded */}
    <div
      class="flex w-full flex-col gap-8 rounded-tl-[32px] rounded-tr-[32px] p-6 md:gap-[64px] md:rounded-tl-[64px] md:rounded-tr-[64px] md:p-[64px]"
      style="background: linear-gradient(to top, rgba(210,225,234,0) 0%, #d2e1ea 100%);"
    >

      {/* ── TOP ROW: heading LEFT, body+CTA RIGHT ── */}
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-8">

        {/* LEFT — eyebrow + h2 */}
        <div class="flex min-w-0 flex-1 flex-col gap-4">
          {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
          {headingHtml
            ? <Heading variant="h2" html={headingHtml} />
            : heading && <Heading variant="h2">{heading}</Heading>
          }
        </div>

        {/* RIGHT — body + CTA */}
        <div class="flex min-w-0 flex-1 flex-col gap-8">
          <slot name="body" />
          {cta && (
            <Button variant="primary" text={cta.text} href={cta.href} hideNote class="self-start" />
          )}
        </div>

      </div>

      {/* ── BOTTOM: full-width image ── */}
      <div class="w-full">
        <slot name="image">
          <!-- TODO: replace with <Image> when asset is ready -->
          <div
            class="w-full rounded-[32px] bg-section-grey"
            style="aspect-ratio: 1695 / 928;"
            aria-hidden="true"
          />
        </slot>
      </div>

    </div>
  </div>
</section>
