---
/**
 * "How Aging Works" section — homepage.
 *
 * Structure:
 *   full-width section, bg-page
 *   ├─ Two-column header
 *   │   ├─ LEFT  eyebrow + h2 + body paragraph
 *   │   └─ RIGHT body copy (2 ¶) + primary CTA
 *   └─ Three-bucket diagram (embedded, not a separate section)
 *
 * Copy is baked in (single-page, client-specific content).
 * Do NOT fork this widget per page.
 */

import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';

export interface Props {
  id?: string;
}

const { id = 'how-aging-works' } = Astro.props;

// Bucket 1 — 4 pillars in 2×2 grid
const pillars = ['Diet', 'Exercise', 'Sleep', 'Social connection'];

// Bucket 2 — trimmed so content fills roughly half the card
const homeItems   = ['Blood pressure', 'Balance', 'Weight & waist'];
const doctorItems = ['A1c (blood sugar)', 'Coronary calcium', 'Medication review'];

// Bucket 3 — centred list
const fancyItems  = ['IV drips', 'Peptides', 'Whole-body MRI', 'Cancer blood panels', 'Supplements'];
---

<section {...(id ? { id } : {})} class="not-prose w-full bg-page">
  <div class="mx-auto w-full max-w-container px-5 py-12 sm:px-8 md:px-16 md:py-[64px] lg:px-[120px]">

    {/* ── Two-column header ── */}
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-[120px]">

      {/* LEFT — eyebrow + heading + intro body */}
      <div class="flex min-w-0 flex-1 flex-col gap-6">
        <div class="flex flex-col gap-4">
          <Heading variant="eyebrow">where your resources go</Heading>
          <Heading variant="h2">
            Do the basics first.<br />
            Then earn the <span class="text-accent">fancy stuff.</span>
          </Heading>
        </div>
        <Text>
          The interventions with the strongest evidence in longevity medicine are also the
          cheapest, and almost nobody does them, because there is nothing to sell. Start
          by finding out where you actually stand. Then fill the first bucket. Everything
          else can wait its turn.
        </Text>
      </div>

      {/* RIGHT — body copy + CTA */}
      <div class="flex min-w-0 flex-1 flex-col justify-center gap-8">
        <div class="flex flex-col gap-4">
          <Text>
            They book the IV drip and the full-body scan while their blood pressure goes
            unmeasured and they haven't stood up from a chair without their hands in a
            decade. That isn't stupidity. It's what the entire industry sells.
          </Text>
          <Text>
            We are not against bucket three. Dr. Peterson files it under recreational
            anti-aging: if you enjoy it and can afford it, help yourself, same as a
            weekend in Las Vegas. The objection is buying it while bucket one sits empty.
          </Text>
        </div>
        <Button variant="primary" text="Understand the model" href="/fill-the-first-bucket" />
      </div>

    </div>{/* end two-column header */}

    {/* ── Bucket diagram ── */}
    <div class="mt-16 md:mt-[80px]">

      {/* Scale bars */}
      <div class="mb-8 flex max-w-sm flex-col gap-1.5">
        {[
          { label: 'Evidence', lo: 'Strongest', hi: 'Thinnest', cls: 'from-primary to-primary/10' },
          { label: 'Cost',     lo: 'Lowest',    hi: 'Highest',  cls: 'from-primary/10 to-primary' },
        ].map(({ label, lo, hi, cls }) => (
          <div class="flex items-center gap-3">
            <span class="type-eyebrow w-16 shrink-0 font-sans text-eyebrow">{label}</span>
            <div class={`h-0.5 flex-1 rounded-full bg-gradient-to-r ${cls}`} />
            <div class="flex shrink-0 gap-3 font-sans text-[11px] text-muted">
              <span>{lo}</span>
              <span>{hi}</span>
            </div>
          </div>
        ))}
      </div>

      {/* "Find your weakest link" CTA */}
      <div class="mb-5">
        <Button variant="primary" text="Find your weakest link" href={PRIMARY_CTA_HREF} hideNote />
      </div>

      {/* Bucket grid — 5 cols on desktop: [1fr auto 1fr auto 1fr]
          Each bucket column is a flex-col wrapper so the label sits
          directly below its card on both mobile and desktop. */}
      <div class="grid grid-cols-1 gap-6
                  lg:grid-cols-[1fr_auto_1fr_auto_1fr]
                  lg:items-start lg:gap-x-0 lg:gap-y-0">

        {/* ─── Bucket 1 + label ─── */}
        <div class="flex flex-col gap-3">
          <a
            href="/four-pillars"
            class="group flex flex-col overflow-hidden rounded-[20px]
                   border-2 border-section-dark no-underline
                   transition-opacity hover:opacity-90
                   focus-visible:outline focus-visible:outline-2
                   focus-visible:outline-offset-2 focus-visible:outline-accent
                   lg:min-h-[500px]"
            aria-label="Bucket 1: The basics — four pillars"
          >
            <div class="bg-section-dark px-4 py-2 text-center">
              <span class="type-eyebrow font-sans text-[11px] text-white/60">Bucket 1</span>
            </div>
            <div class="flex flex-1 flex-col bg-section-grey">
              <div class="flex flex-col gap-4 p-5 md:p-6">
                <h3 class="font-heading text-h2 font-normal leading-none text-heading text-center">
                  The basics
                </h3>
                <div class="grid grid-cols-2 gap-2">
                  {pillars.map((item) => (
                    <div class="rounded-[12px] bg-white px-3 py-3 text-center
                                font-sans text-[13px] font-semibold leading-[1.3] text-heading">
                      {item}
                    </div>
                  ))}
                </div>
              </div>
              <div class="flex-1" />
              <div class="px-5 pb-5 text-center font-sans text-[12px] leading-[1.5] text-muted">
                No order inside. All four count.<br />Social connection → the Ohana
              </div>
            </div>
          </a>
          {/* Label below card */}
          <div class="flex flex-col gap-0.5 text-center">
            <p class="font-sans text-[13px] font-bold text-heading">Strongest evidence · Lowest cost</p>
            <p class="font-sans text-[12px] text-muted">Fill first</p>
          </div>
        </div>

        {/* Connector 1 → 2 */}
        <div class="hidden items-start justify-center pt-40 px-3 lg:flex lg:flex-col lg:items-center lg:gap-0.5">
          <span class="type-eyebrow font-sans text-[10px] leading-[1.3] text-muted text-center">
            spills<br />over
          </span>
          <span class="font-sans text-[18px] leading-none text-muted">→</span>
        </div>
        {/* Mobile connector */}
        <div class="flex items-center gap-2 lg:hidden">
          <span class="type-eyebrow font-sans text-[10px] text-muted">spills over</span>
          <span class="text-muted">→</span>
        </div>

        {/* ─── Bucket 2 + label ─── */}
        <div class="flex flex-col gap-3">
          <a
            href="/talk-to-your-doctor"
            class="group flex flex-col overflow-hidden rounded-[20px]
                   border-2 border-primary no-underline
                   transition-opacity hover:opacity-90
                   focus-visible:outline focus-visible:outline-2
                   focus-visible:outline-offset-2 focus-visible:outline-accent
                   lg:min-h-[500px]"
            aria-label="Bucket 2: Ask your doctor"
          >
            <div class="bg-primary px-4 py-2 text-center">
              <span class="type-eyebrow font-sans text-[11px] text-white/60">Bucket 2</span>
            </div>
            <div class="flex flex-1 flex-col bg-section-grey">
              <div class="flex flex-col gap-4 p-5 md:p-6">
                <h3 class="font-heading text-h2 font-normal leading-none text-heading text-center">
                  Ask your<br />doctor
                </h3>
                <div class="flex divide-x divide-primary/20 font-sans text-[12px]">
                  <div class="flex flex-1 flex-col gap-1 pr-3">
                    <span class="type-eyebrow mb-1 font-sans text-[10px] text-eyebrow">
                      Check at home
                    </span>
                    {homeItems.map((item) => (
                      <span class="leading-[1.5] text-primary">{item}</span>
                    ))}
                  </div>
                  <div class="flex flex-1 flex-col gap-1 pl-3">
                    <span class="type-eyebrow mb-1 font-sans text-[10px] text-eyebrow">
                      Doctor orders
                    </span>
                    {doctorItems.map((item) => (
                      <span class="leading-[1.5] text-primary">{item}</span>
                    ))}
                  </div>
                </div>
              </div>
              <div class="flex-1" />
              <div class="px-5 pb-5 text-center font-sans text-[12px] leading-[1.5] text-muted">
                You don&apos;t know what you don&apos;t know.
              </div>
            </div>
          </a>
          {/* Label below card */}
          <div class="flex flex-col gap-0.5 text-center">
            <p class="font-sans text-[13px] font-bold text-heading">Strong evidence · Moderate cost</p>
            <p class="font-sans text-[12px] text-muted">Fill once bucket 1 is on its way</p>
          </div>
        </div>

        {/* Connector 2 → 3 */}
        <div class="hidden items-start justify-center pt-40 px-3 lg:flex lg:flex-col lg:items-center lg:gap-0.5">
          <span class="type-eyebrow font-sans text-[10px] leading-[1.3] text-muted text-center">
            spills<br />over
          </span>
          <span class="font-sans text-[18px] leading-none text-muted">→</span>
        </div>
        {/* Mobile connector */}
        <div class="flex items-center gap-2 lg:hidden">
          <span class="type-eyebrow font-sans text-[10px] text-muted">spills over</span>
          <span class="text-muted">→</span>
        </div>

        {/* ─── Bucket 3 + label ─── */}
        <div class="flex flex-col gap-3">
          <a
            href="/how-aging-works#bucket-3"
            class="group flex flex-col overflow-hidden rounded-[20px]
                   border-2 border-dashed no-underline
                   transition-opacity hover:opacity-90
                   focus-visible:outline focus-visible:outline-2
                   focus-visible:outline-offset-2 focus-visible:outline-accent
                   lg:min-h-[500px]"
            style="border-color: var(--aw-color-text-tan); background-color: var(--aw-color-bg-page);"
            aria-label="Bucket 3: The fancy stuff"
          >
            <div class="px-4 pt-4 text-center">
              <span class="type-eyebrow font-sans text-[11px]"
                    style="color: var(--aw-color-text-tan);">Bucket 3</span>
            </div>
            <div class="flex flex-1 flex-col" style="background-color: var(--aw-color-bg-page);">
              <div class="flex flex-col items-center gap-3 px-5 py-4 md:px-6">
                <h3 class="font-heading text-h2 font-normal leading-none text-heading text-center">
                  The fancy stuff
                </h3>
                <div class="flex flex-col items-center gap-1.5 font-sans text-[15px] text-heading">
                  {fancyItems.map((item) => (
                    <span class="text-center leading-[1.4]">{item}</span>
                  ))}
                </div>
              </div>
              <div class="flex-1" />
              <div class="px-5 pb-5 text-center font-sans text-[12px] leading-[1.5] text-muted">
                Optional. Recreational anti-aging.<br />Nothing for us to sell you here.
              </div>
            </div>
          </a>
          {/* Label below card */}
          <div class="flex flex-col gap-0.5 text-center">
            <p class="font-sans text-[13px] font-bold text-heading">Thin evidence · Highest cost</p>
            <p class="font-sans text-[12px] text-muted">Only with whatever spills over</p>
          </div>
        </div>

      </div>{/* end bucket grid */}

      {/* Footer note */}
      <p class="mt-8 font-sans text-body text-muted">
        Buckets hold your time, money and attention, not your health.
      </p>

    </div>{/* end bucket diagram */}

  </div>
</section>
