---
import { Icon } from 'astro-icon/components';
import type { NavLink } from './types';

export interface Props {
  links: NavLink[];
  currentPath: string;
}

const { links, currentPath } = Astro.props;
---

<nav
  class="items-center w-full md:w-auto hidden md:flex md:ml-auto text-default overflow-y-auto overflow-x-hidden md:overflow-visible"
  data-desktop-nav
  aria-label="Main navigation"
>
  <ul class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[15px] tracking-[0.01rem] font-medium md:justify-center">
    {
      links.map(({ text, href, links: childLinks, columns }) => {
        const isDropdown = Boolean(childLinks?.length || columns?.length);
        return (
        <li class:list={[{ dropdown: isDropdown, mega: Boolean(columns?.length), 'md:relative': isDropdown }]}>
          {isDropdown ? (
            <>
              <div class="flex items-center">
              {href ? (
              <a
                href={href}
                class:list={[
                  'text-white/80 hover:text-white px-[8px] py-3 flex items-center flex-1 min-w-0 whitespace-nowrap',
                  { 'aw-link-active': href === currentPath },
                ]}
              >
                {text}{' '}
                <Icon
                  name="tabler:chevron-down"
                  class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline transition-transform duration-200"
                />
              </a>
              ) : (
              <button
                type="button"
                data-aw-toggle-dropdown
                aria-expanded="false"
                class="text-white/80 hover:text-white px-[8px] py-3 flex items-center flex-1 min-w-0 whitespace-nowrap select-none text-left"
              >
                {text}{' '}
                <Icon
                  name="tabler:chevron-down"
                  class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline transition-transform duration-200"
                />
              </button>
              )}
              <button
                type="button"
                data-aw-toggle-dropdown
                aria-expanded="false"
                aria-label={`Toggle ${text} submenu`}
                class="md:hidden shrink-0 p-3 text-white/80 hover:text-white"
              >
                <Icon name="tabler:chevron-down" class="w-5 h-5 transition-transform duration-200" />
              </button>
              </div>
              {columns?.length ? (
              <div class="dropdown-menu mega-menu hidden md:backdrop-blur-md rounded md:absolute md:top-full md:left-1/2 md:-mt-1 pl-4 md:pl-0 font-medium md:bg-card-dark md:w-[900px] md:max-w-[calc(100vw-2rem)] md:z-50 drop-shadow-xl">
                <div class="mega-menu-columns flex flex-col md:grid md:gap-8 md:p-5" style={`--mega-columns: ${columns.length}`}>
                  {columns.map((col) => (
                    <div class="min-w-0">
                      <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-accent px-5 md:px-2 pt-3 md:pt-0 pb-1">
                        {col.title}
                      </p>
                      <ul>
                        {col.links.map(({ text: text2, href: href2 }) => (
                          <li>
                            <a
                              class:list={[
                                'first:rounded-t last:rounded-b hover:bg-accent/[0.12] hover:text-white text-white/80 py-2 px-5 md:px-2 block whitespace-normal break-words',
                                { 'aw-link-active': href2 === currentPath },
                              ]}
                              href={href2}
                            >
                              {text2}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
              ) : (
              <ul class="dropdown-menu hidden md:backdrop-blur-md rounded md:absolute pl-4 md:pl-0 font-medium md:bg-card-dark md:min-w-[200px] drop-shadow-xl">
                {childLinks?.map(({ text: text2, href: href2, links: links2 }) => (
                  <li class:list={[{ 'relative group/nested': links2?.length }]}>
                    <a
                      class:list={[
                        'first:rounded-t last:rounded-b hover:bg-accent/[0.12] hover:text-white text-white/80 py-2 px-5 block whitespace-normal break-words md:whitespace-nowrap',
                        { 'aw-link-active': href2 === currentPath },
                        { 'flex items-center justify-between': links2?.length },
                      ]}
                      href={href2}
                    >
                      {text2}
                      {links2?.length && (
                        <Icon
                          name="tabler:chevron-right"
                          class="w-3.5 h-3.5 ml-2 hidden md:inline"
                        />
                      )}
                    </a>
                    {links2?.length && (
                      <ul class="hidden md:absolute md:left-full md:top-0 group-hover/nested:md:block pl-4 md:pl-0 md:backdrop-blur-md rounded font-medium md:bg-card-dark md:min-w-[200px] drop-shadow-xl">
                        {links2.map(({ text: text3, href: href3 }) => (
                          <li>
                            <a
                              class:list={[
                                'first:rounded-t last:rounded-b hover:bg-accent/[0.12] hover:text-white text-white/80 py-2 px-5 block whitespace-normal break-words md:whitespace-nowrap',
                                { 'aw-link-active': href3 === currentPath },
                              ]}
                              href={href3}
                            >
                              {text3}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
              )}
            </>
          ) : (
            <a
              class:list={[
                'text-white/80 hover:text-white px-[8px] py-3 flex items-center whitespace-nowrap',
                { 'aw-link-active': href === currentPath },
              ]}
              href={href}
            >
              {text}
            </a>
          )}
        </li>
        );
      })
    }
  </ul>
</nav>
