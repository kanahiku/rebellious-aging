---
/**
 * BucketsSection — "The Three Buckets" section (Figma node 176:20).
 *
 * Top: pull-quote left + "Four rules that make this work" right.
 * Then: shared BucketGraphic with the animated three-bucket cascade.
 *
 * Used on /fill-the-first-bucket. Copy comes from Sanity; the bucket graphic stays in code.
 */
import BucketGraphic from '~/components/ui/BucketGraphic.astro';

export interface Props {
  /** Pull-quote paragraphs, as safe HTML (use `cmsHeading` so **words** become the accent span). */
  pullQuote: string[];
  /** Heading for the rules column; "\n" becomes a line break on wider screens. */
  rulesHeading: string;
  rules: { title: string; body: string }[];
}

const { pullQuote = [], rulesHeading = '', rules = [] } = Astro.props;
const rulesHtml = rulesHeading
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .split('\n')
  .join('<br class="hidden sm:block" /> ');
const rulesHeadingHtml = rulesHtml;
---

<section class="not-prose w-full py-12 md:py-16 lg:py-[80px]">
  <div class="mx-auto flex w-full max-w-container flex-col gap-12 px-5 sm:px-8 md:gap-16 md:px-16 lg:px-[120px]">
    {/* ── TOP: pull-quote | rules ── */}
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-[120px]">
      {/* Pull quote */}
      <div class="flex min-w-0 flex-1 flex-col gap-[1.3em] font-heading text-h3 font-normal leading-[1.2] text-heading">
        {pullQuote.map((paragraph) => <p set:html={paragraph} />)}
      </div>

      {/* Four rules */}
      <div class="flex min-w-0 flex-1 flex-col gap-6">
        <h2 class="font-heading text-h2 font-normal leading-none text-heading" set:html={rulesHeadingHtml} />
        <div class="font-sans text-small leading-[1.3] text-muted space-y-[1.3em]">
          {
            rules.map((rule) => (
              <p>
                <strong class="font-bold">{rule.title}</strong> {rule.body}
              </p>
            ))
          }
        </div>
      </div>
    </div>

    {/* ── Shared bucket graphic — full width here so it does not feel cramped ── */}
    <div class="w-full">
      <BucketGraphic />
    </div>
  </div>
</section>
