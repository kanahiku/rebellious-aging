---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import Heading from '~/components/ui/Heading.astro';

export interface Props {
  tagline?: string;
  title?: string;
  content?: string;
  image?: any;
  hasImage: boolean;
}

const { tagline, title, content, image, hasImage } = Astro.props;
---

<div class="flex flex-1 flex-col lg:flex-row lg:items-center lg:justify-between gap-0 lg:gap-[48px] pb-0">
  {/* left: text column */}
  <div class="flex flex-col items-start gap-6 lg:gap-[32px] shrink-0 lg:max-w-[628px] pb-8 pt-4 lg:py-0">
    {tagline && <Heading variant="eyebrow" color="white" class="opacity-60" html={tagline} />}
    {title && <h1 class="font-heading text-h1 font-normal leading-none text-white" set:html={title} />}
    {content && (
      <div class="font-sans text-body leading-[1.3] text-white/60 max-w-[520px]" set:html={content} />
    )}
  </div>
  {/* right: image column — visible on all screen sizes */}
  <div class="w-full h-[280px] sm:h-[360px] lg:h-[620px] lg:flex-[0_1_42%] lg:min-w-0 lg:self-end">
    {hasImage ? (
      <div class="relative w-full h-full overflow-hidden rounded-tl-[32px] rounded-tr-[32px]">
        {typeof image === 'string' ? (
          <Fragment set:html={image} />
        ) : image && typeof image === 'object' && 'src' in image && 'width' in image ? (
          <AstroImage
            src={image as ImageMetadata}
            alt={(image as any).alt ?? ''}
            class="w-full h-full object-cover object-top"
            widths={[400, 640, 828, 1080]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            format="webp"
            quality={85}
            loading="eager"
            decoding="async"
          />
        ) : image &&
          typeof image === 'object' &&
          'src' in image &&
          typeof image.src === 'string' &&
          image.src ? (
          <Image
            src={image.src}
            alt={'alt' in image && typeof image.alt === 'string' ? image.alt : ''}
            class="w-full h-full object-cover object-top"
            layout="none"
            widths={[400, 640, 828, 1080]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            format="webp"
            quality={85}
            loading="eager"
            decoding="async"
          />
        ) : null}
        <div class="absolute inset-0 bg-gradient-to-b from-transparent from-[62%] to-section-dark" />
      </div>
    ) : (
      /* TODO: replace with <Image> when asset is ready */
      <div
        class="w-full h-full min-h-[400px] rounded-tl-[32px] rounded-tr-[32px] bg-section-grey"
        aria-hidden="true"
      />
    )}
  </div>
</div>
