---
export interface Props {
  title?: string;
  subtitle?: string;
  withImage: boolean;
  isPageOverlay: boolean;
}

const { title, subtitle, withImage, isPageOverlay } = Astro.props;
---

<div
  class:list={[
    'flex w-full flex-1 flex-col',
    isPageOverlay
      ? 'items-start justify-center py-16 md:py-[120px]'
      : withImage
        ? 'items-stretch pt-16 pb-[72px] md:pt-[120px]'
        : 'items-start py-16 md:py-[120px]',
  ]}
>
  <div class:list={['flex w-full flex-1 flex-col items-start gap-8 md:gap-10']}>
    {title && (
      <h1
        class:list={[
          'font-heading text-h1 shrink-0 overflow-visible font-normal leading-none [text-box-edge:cap_leading] [text-box-trim:trim-both]',
          isPageOverlay
            ? 'text-white'
            : 'bg-[linear-gradient(98deg,var(--aw-color-bg-section-dark)_5%,var(--aw-color-primary)_97%)] bg-clip-text text-transparent',
          'w-full',
        ]}
        set:html={title}
      />
    )}
    {subtitle && (
      <div
        class:list={[
          'font-sans text-body leading-[1.3] [&_p+p]:mt-[1lh]',
          isPageOverlay ? 'text-white/85' : 'text-muted',
          'w-full lg:w-1/2',
        ]}
        set:html={subtitle}
      />
    )}
  </div>
</div>
