---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArtDirectedImage from '~/components/ui/ArtDirectedImage.astro';
import type { ContentImage } from '~/lib/content/types';

export interface Props {
  image?: unknown;
  desktop?: ContentImage;
  mobile?: ContentImage;
  isLocal: boolean;
  hasPhoto: boolean;
}

const { image, desktop, mobile, isLocal, hasPhoto } = Astro.props;
const localAlt = image && typeof image === 'object' && 'alt' in image && typeof image.alt === 'string' ? image.alt : '';
---

{isLocal ? (
  <AstroImage
    src={image as ImageMetadata}
    alt={localAlt}
    class="absolute inset-0 h-full w-full object-cover object-center"
    widths={[640, 828, 1200, 1440, 1920, 2160]}
    sizes="100vw"
    format="webp"
    quality={85}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
) : hasPhoto ? (
  <ArtDirectedImage
    desktop={desktop}
    mobile={mobile}
    class="absolute inset-0 h-full w-full object-cover object-center"
    widths={[768, 1200, 1600, 1920]}
    mobileWidths={[400, 640, 828, 1080]}
    sizes="100vw"
    mobileSizes="100vw"
    loading="eager"
    fetchpriority="high"
    width={1920}
    layout="cover"
    format="webp"
  />
) : null}
