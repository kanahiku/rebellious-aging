---
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import CTAActions from '~/components/ui/CTAActions.astro';

export interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  content?: string;
  actions?: any;
}

const { tagline, title, subtitle, content, actions } = Astro.props;
---

<div class="flex min-h-0 flex-1 flex-col items-start justify-center gap-12 pb-12 md:pb-16">
  <div class="flex w-full flex-col items-start gap-8">
    {tagline && (
      <Heading
        variant="h4"
        as="p"
        color="inherit"
        style="font-size: clamp(1.375rem, 0.94vw + 1.155rem, 2rem); line-height: 1;"
        class="text-page mix-blend-overlay"
        html={tagline}
      />
    )}
    {title && <h1 class="font-heading text-h1 font-normal leading-none text-page" set:html={title} />}
    {subtitle && (
      <Text
        variant="body-lg"
        as="div"
        color="white"
        class="max-w-[620px] !font-light leading-[1.3] [&_p+p]:mt-[1lh]"
        html={subtitle}
      />
    )}
  </div>

  <div class="flex w-full max-w-[434px] flex-col items-start gap-8">
    {actions &&
      (Array.isArray(actions) ? (
        <CTAActions actions={actions} noteTone="onDark" />
      ) : (
        <Fragment set:html={actions} />
      ))}
    {content && <Text variant="body-lg" color="white" class="!font-light leading-[1.3]" html={content} />}
  </div>
</div>
