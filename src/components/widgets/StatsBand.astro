---
/**
 * StatsBand — 3 horizontal stat cards (Figma node 310:1235, The Ohana page).
 *
 * Visual spec (from Figma):
 *   bg-page, py-[64px]. 3 equal-width white cards in a row, gap-[32px].
 *   Card: bg-white, rounded-[16px], p-[24px], gap-[12px], drop-shadow subtle.
 *   Number: text-primary (#2c4a5b), 52px Fraunces, leading-[1.2].
 *   Label:  text-muted (#45555d), 16px Hanken, centered, leading-[1.3].
 */

export interface StatItem {
  number: string;
  label: string;
}

export interface Props {
  stats: StatItem[];
  id?: string;
}

const { stats = [], id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full bg-page">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">
    <div class="grid grid-cols-1 gap-[32px] md:grid-cols-3">
      {stats.map((item) => (
        <div class="flex flex-col items-center gap-3 rounded-[16px] bg-white p-6 text-center shadow-[4px_4px_10px_rgba(0,0,0,0.05)]">
          <span class="font-heading text-[52px] leading-[1.2] text-primary">
            {item.number}
          </span>
          <p class="text-center text-[16px] leading-[1.3] text-muted">{item.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
