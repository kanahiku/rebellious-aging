---
/**
 * OhanaActivities — 2-col split: heading + image left / activity CARDS right
 * (Figma node 310:1447, The Ohana page).
 *
 * Visual spec (from Figma):
 *   bg-page, p-[120px]. 2-col flex, gap-[64px], items-start.
 *   LEFT  flex-1: h2 heading (gap-[32px] below) + optional subtitle + image (flex-1, rx-32).
 *   RIGHT flex-1: 4 activity CARDS, gap-[12px] between them.
 *     Each card: bg-white, rounded-[16px], shadow-[4px_4px_30px_0px_rgba(0,0,0,0.05)], p-[16px].
 *     Inside: eyebrow frequency (#567f9b, 12px, uppercase) / h4 (#2c4a5b, 28px) / body (#45555d, 14px).
 *     gap-[16px] between card elements.
 */

import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface ActivityItem {
  frequency: string;
  title: string;
  body: string;
}

export interface Props {
  heading: string;
  subtitle?: string;
  activities: ActivityItem[];
  id?: string;
}

const { heading, subtitle, activities = [], id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full bg-page py-12 md:py-16 lg:py-[120px]">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-[64px]">

      {/* LEFT: heading + subtitle + image */}
      <div class="flex min-w-0 flex-1 flex-col self-stretch">
        <div class="flex flex-col gap-[32px]">
          <div class="flex flex-col gap-4">
            <Heading variant="h2">{heading}</Heading>
            {subtitle && <Text variant="body">{subtitle}</Text>}
          </div>
        </div>
        <div class="mt-[32px] min-h-[280px] flex-1">
          <slot name="image">
            <!-- TODO: replace with <Image> when asset is ready -->
            <div
              class="h-full w-full rounded-[32px] bg-section-grey"
              style="min-height: 280px;"
              aria-hidden="true"
            />
          </slot>
        </div>
      </div>

      {/* RIGHT: activity cards */}
      <div class="flex min-w-0 flex-1 flex-col gap-3">
        {activities.map((item) => (
          <div class="flex flex-col gap-4 rounded-[16px] bg-white p-4 shadow-[4px_4px_30px_0px_rgba(0,0,0,0.05)]">
            <p class="font-sans text-[12px] uppercase tracking-[0.06em] text-accent">
              {item.frequency}
            </p>
            <h4 class="font-heading text-[28px] leading-[1.2] text-primary">
              {item.title}
            </h4>
            <p class="font-sans text-[14px] leading-[1.45] text-muted">{item.body}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
