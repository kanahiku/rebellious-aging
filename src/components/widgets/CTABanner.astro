---
/**
 * CTABanner — mid-page CTA band (Figma node 2:304/2:323).
 *
 * Visual spec:
 *   Dark navy gradient pill (rounded-full), two-column layout.
 *   Left:  eyebrow (muted) + h2 heading (cream)
 *   Right: body text + standalone CTA button
 *
 *   Background: linear-gradient(100.7°, sectionDark → primary)
 *   Button: ghost/dark variant (bg-primary/20, border-cream, text-white) + backdrop-blur
 *
 * Usage:
 *   <CTABanner
 *     eyebrow="Know where to aim"
 *     title="Find your weakest link."
 *     subtitle="Ninety-six questions, one at a time, about ten minutes. …"
 *   />
 *
 * Note: Old template props (showAfterHoursNote, license, extraLines) are accepted
 * but ignored — kept only for TypeScript backward-compat during page migration.
 */

import Button from '~/components/ui/Button.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  disclaimer?: string;
  id?: string;

  /** @deprecated Legacy template props — accepted but ignored. */
  showAfterHoursNote?: boolean;
  /** @deprecated Legacy template prop — accepted but ignored. */
  license?: string;
  /** @deprecated Legacy template props — accepted but ignored. */
  extraLines?: string[];
}

const {
  eyebrow,
  title,
  subtitle,
  id,
} = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full py-8 md:py-16">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">

    <div
      class="flex w-full flex-col items-start gap-8 rounded-[32px] px-6 py-10 md:px-10 md:py-12 lg:flex-row lg:items-center lg:gap-16 lg:rounded-full lg:px-[96px] lg:py-[64px]"
      style="background: linear-gradient(100.7deg, var(--aw-color-bg-section-dark) 5.27%, var(--aw-color-primary) 97.29%);"
    >

      {/* ── LEFT column: eyebrow + heading ── */}
      <div class="flex min-w-0 flex-1 flex-col gap-4">
        {eyebrow && (
          <Heading variant="eyebrow" color="white">{eyebrow}</Heading>
        )}
        <Heading variant="h2" color="inherit" class="text-white">{title}</Heading>
      </div>

      {/* ── RIGHT column: body + standalone CTA ── */}
      <div class="flex min-w-0 flex-1 flex-col gap-8">
        {subtitle && (
          <Text color="inherit" class="text-white">{subtitle}</Text>
        )}

        <Button
          variant="ghost"
          tone="dark"
          text={PRIMARY_CTA_LABEL}
          href={PRIMARY_CTA_HREF}
          class="w-auto shrink-0 self-start backdrop-blur-[10px]"
          hideNote={true}
        />
      </div>

    </div>
  </div>
</section>
