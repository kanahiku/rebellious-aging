---
/**
 * Hero section — overlay (photo background), split (image right/left),
 * words (photo + three positioned words), page (light gradient + title / lede),
 * and title (photo + centered h1).
 *
 * This is the single hero widget for the whole site. Do NOT fork per page.
 * Nav slot accepts <Header embedded /> — the same glass-pill nav used on every page.
 *
 * Atoms used: Heading, Text, CTAActions.
 */
import { Image as AstroImage } from 'astro:assets';
import HeroBgImage from './hero/HeroBgImage.astro';
import HeroWords from './hero/HeroWords.astro';
import HeroTitle from './hero/HeroTitle.astro';
import HeroDarkPage from './hero/HeroDarkPage.astro';
import HeroPage from './hero/HeroPage.astro';
import HeroSplitDark from './hero/HeroSplitDark.astro';
import HeroOverlayContent from './hero/HeroOverlayContent.astro';
import HeroSplitLight from './hero/HeroSplitLight.astro';
import Heading from '~/components/ui/Heading.astro';
import type { ContentImage } from '~/lib/content/types';
import type { ImageMetadata } from 'astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  imageMobile,
  variant = 'split',
  words = [],
  height = 'default',
  isReversed = false,
  overlapHeader = true,
  withImage = false,
  pageOverlay = false,
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const isWords = variant === 'words';
const isTitle = variant === 'title';
const isPage = variant === 'page';
const isDarkPage = variant === 'dark-page';
const isSplitDark = variant === 'split-dark';
const isOverlay = variant === 'overlay' || isWords || isTitle;
const isPageOverlay = isPage && withImage && pageOverlay;
const isChrome = isOverlay || isPage || isDarkPage || isSplitDark;
const hasStats = variant === 'overlay' && Astro.slots.has('stats');
const hasNav = Astro.slots.has('nav');
const hasImage = Boolean(image && (typeof image !== 'string' || image.trim()));
const isSplitImage = !isOverlay && !isSplitDark && hasImage;

const asContentImage = (value: unknown): ContentImage | undefined => {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return undefined;
  const src = 'src' in value && typeof value.src === 'string' ? value.src.trim() : '';
  if (!src) return undefined;
  const alt = 'alt' in value && typeof value.alt === 'string' ? value.alt : '';
  return { src, alt };
};

const overlayDesktop = isOverlay ? asContentImage(image) : undefined;
const overlayMobile = isOverlay ? asContentImage(imageMobile) : undefined;
const pageOverlayDesktop = isPageOverlay ? asContentImage(image) : undefined;
const pageOverlayMobile = isPageOverlay ? asContentImage(imageMobile) : undefined;
const hasOverlayPhoto = Boolean(overlayDesktop || overlayMobile);
const hasPageOverlayPhoto = Boolean(pageOverlayDesktop || pageOverlayMobile);
const isLocalOverlayImage =
  isOverlay &&
  Boolean(image) &&
  typeof image === 'object' &&
  image !== null &&
  !Array.isArray(image) &&
  'width' in image &&
  'height' in image;
const isLocalPageImage =
  isPage &&
  Boolean(image) &&
  typeof image === 'object' &&
  image !== null &&
  !Array.isArray(image) &&
  'src' in image &&
  'width' in image &&
  'height' in image &&
  typeof image.src === 'string';
---

{
  isChrome ? (
    <section
      class:list={[
        'relative not-prose overflow-hidden flex flex-col w-full',
        !(isPage && withImage && !isPageOverlay) && 'rounded-b-hero',
        isPage && !isPageOverlay && 'bg-gradient-to-t from-transparent to-section-grey',
        isWords && 'min-h-[520px] md:h-[579px] md:min-h-[579px]',
        isTitle &&
          (height === 'page' ? 'min-h-[480px] md:min-h-[629px]' : 'min-h-[320px] md:h-[450px] md:min-h-[450px]'),
        isPage && 'min-h-[480px] md:min-h-[629px]',
        isDarkPage && 'bg-section-dark min-h-[520px] md:min-h-[640px]',
        isOverlay && !isWords && !isTitle && 'min-h-[90vh]',
        isSplitDark && 'bg-section-dark min-h-[560px] md:min-h-[740px]',
      ]}
      {...(id ? { id } : {})}
    >
      {isOverlay && (
        <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
          <slot name="bg">{bg ? <Fragment set:html={bg} /> : null}</slot>
          {isLocalOverlayImage || hasOverlayPhoto ? (
            <HeroBgImage image={image} desktop={overlayDesktop} mobile={overlayMobile} isLocal={isLocalOverlayImage} hasPhoto={hasOverlayPhoto} />
          ) : isWords || isTitle ? (
            /* TODO: replace with <Image> when asset is ready */
            <div
              class="absolute inset-0 bg-section-grey"
              style={isTitle ? 'aspect-ratio: 1440 / 450;' : 'aspect-ratio: 1440 / 579;'}
              aria-hidden="true"
            />
          ) : null}
          {isTitle ? (
            /* Figma 310:927 — simple 30% black scrim over the photo */
            <div class="absolute inset-0 z-[1] bg-black/30" />
          ) : isWords ? (
            <div class="absolute inset-0 z-[1] bg-heading/10" />
          ) : (
            <>
              {/* Mobile: full scrim so stacked text is always readable */}
              <div class="absolute inset-0 z-[1] bg-black/50 md:hidden" />
              {/* Desktop: Figma 309:528 — left-to-right: black/60 at left edge → fully transparent at 60% */}
              <div class="absolute inset-0 z-[1] hidden md:block bg-[linear-gradient(to_right,rgba(0,0,0,0.60)_0%,transparent_60%)]" />
              {/* Bottom cream fade — transitions into the next section */}
              <div class="absolute inset-0 z-[1] bg-[linear-gradient(to_bottom,transparent_88%,rgba(245,244,239,0.35)_100%)]" />
            </>
          )}
        </div>
      )}

      {isPageOverlay && (
        <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
          {isLocalPageImage || hasPageOverlayPhoto ? (
            <HeroBgImage image={image} desktop={pageOverlayDesktop} mobile={pageOverlayMobile} isLocal={isLocalPageImage} hasPhoto={hasPageOverlayPhoto} />
          ) : (
            <div class="absolute inset-0 bg-section-grey" aria-hidden="true" />
          )}
          <div class="absolute inset-0 z-[1] bg-[linear-gradient(to_right,rgba(0,0,0,0.72)_0%,rgba(0,0,0,0.45)_42%,transparent_100%)]" />
        </div>
      )}

      <div
        class:list={[
          'relative z-[2] flex flex-1 flex-col w-full max-w-container mx-auto px-5 py-6 sm:px-8 md:px-16 lg:px-[120px] lg:py-8',
          isSplitDark ? 'gap-16' : isOverlay && !isWords && !isTitle ? 'justify-between' : 'gap-2.5',
          isPage && withImage && !isPageOverlay && 'pb-0 lg:pb-0',
        ]}
      >
        <slot name="nav" />
        {overlapHeader && !hasNav && <div class="pt-0 md:pt-[76px] pointer-events-none" />}

        {isWords ? (
          <HeroWords words={words} />
        ) : isTitle ? (
          <HeroTitle title={title} actions={actions} />
        ) : isDarkPage ? (
          <HeroDarkPage tagline={tagline} title={title} subtitle={subtitle} actions={actions} />
        ) : isPage ? (
          <HeroPage title={title} subtitle={subtitle} withImage={withImage} isPageOverlay={isPageOverlay} />
        ) : isSplitDark ? (
          <HeroSplitDark tagline={tagline} title={title} content={content} image={image} hasImage={hasImage} />
        ) : (
          <HeroOverlayContent tagline={tagline} title={title} subtitle={subtitle} content={content} actions={actions} />
        )}
      </div>

      {isPage &&
        withImage &&
        !isPageOverlay &&
        (isLocalPageImage ? (
          <AstroImage
            src={image as ImageMetadata}
            alt={'alt' in (image as object) && typeof (image as any).alt === 'string' ? (image as any).alt : ''}
            class="relative z-[2] w-full h-[550px] object-cover object-center"
            widths={[640, 828, 1200, 1440, 1920]}
            sizes="100vw"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="relative z-[2] w-full h-[550px] bg-section-grey" aria-hidden="true" />
        ))}

      {hasStats && (
        <div class="relative bg-[rgb(14_13_7_/_0.1)] backdrop-blur-[15px]">
          <div class="max-w-container mx-auto px-4 sm:px-6 py-2 md:py-[22px]">
            <slot name="stats" />
          </div>
        </div>
      )}
    </section>
  ) : (
    <section class:list={['relative not-prose', overlapHeader && 'md:-mt-[76px]']} {...(id ? { id } : {})}>
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <slot name="bg">{bg ? <Fragment set:html={bg} /> : null}</slot>
      </div>
      <HeroSplitLight {tagline} {title} {subtitle} {content} {actions} {image} {hasImage} {isSplitImage} {isReversed} {overlapHeader} />
    </section>
  )
}
