---
import Layout from '~/layouts/PageLayout.astro';
import DecadeSections from '~/components/widgets/DecadeSections.astro';
import { getDecadeContent } from '~/lib/content';

/** /in-your-30s. All copy comes from the Sanity `decadePage` document `decade-30s`. */
const page = await getDecadeContent('30s');

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header" />
  <DecadeSections page={page} />
</Layout>
