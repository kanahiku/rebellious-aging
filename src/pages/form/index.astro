---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Rebellious Aging Self-Assessment',
  description: 'A private 32-system self-check. Your answers never leave your device.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Full-screen immersive quiz — no site nav -->
  <div id="quiz-root">
    <!-- ═══════════════════════════════════ PROGRESS HEADER ═══════════════════════════════════ -->
    <!-- Sits outside <main> so it's always above compositing layers from backdrop-filter cards -->
    <header class="quiz-header hidden" id="quiz-header">
      <div class="quiz-header-inner">
        <div class="quiz-progress-row">
          <span class="quiz-prog-left" id="prog-section">Section 1 of 6</span>
          <span class="quiz-prog-center" id="prog-tab">Movement and structure</span>
          <span class="quiz-prog-right" id="prog-count">0 of 112 answered</span>
        </div>
        <div class="quiz-progress-track" id="prog-track">
          <div class="quiz-progress-fill" id="prog-fill"></div>
          <div class="quiz-progress-remaining" id="prog-remaining"></div>
        </div>
      </div>
      <!-- Sponsor card — visible on every step, anchored to the top -->
      <div class="quiz-sponsor-card"><a href="/athena-evaluation" class="quiz-sponsor-link">Paid for by Athena Clinic</a></div>
    </header>

    <!-- ═══════════════════════════════════ SCREENS ══════════════════════════════════ -->
    <main class="quiz-main" id="quiz-main">
      <!-- HOME SCREEN -->
      <section class="quiz-screen on quiz-home-screen" id="sc-home">
        <div class="quiz-home-card">
          <!-- Eyebrow -->
          <p class="quiz-home-eyebrow">THIRTY TWO SYSTEMS, ONE SELF-ASSESSMENT</p>
          <!-- Heading -->
          <h1 class="quiz-home-heading">Nobody ages all at once.</h1>
          <!-- Body -->
          <p class="quiz-home-body">
            You have thirty-two biological ages and they disagree. This asks about the things you can already notice,
            and the things you have quietly stopped mentioning.
          </p>

          <!-- Feature pills -->
          <div class="quiz-home-features">
            <span class="quiz-home-feature">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"></circle><path
                  d="M12 6v6l4 2"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"></path></svg
              >
              15 mins
            </span>
            <span class="quiz-home-feature">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><path
                  d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
              Print ready results for clinicians
            </span>
          </div>

          <!-- Stop list disclosure -->
          <details class="quiz-stop-details">
            <summary class="quiz-stop-summary">⚠ Important: read before starting</summary>
            <div class="quiz-stop-body">
              <p>Put this down and contact a doctor today if any of these applies right now:</p>
              <ul>
                <li>Chest pain, pressure or tightness, especially on exertion</li>
                <li>Fainting, blacking out, or near-fainting</li>
                <li>New or sudden weakness, numbness, drooping or difficulty speaking</li>
                <li>Sudden loss or distortion of vision in either eye</li>
                <li>Coughing up blood, or blood in stool or urine</li>
                <li>Unintentional weight loss of more than 10 lb without trying</li>
                <li>A fall that caused injury, or repeated falls</li>
                <li>A new or rapidly changing mole, lump or skin lesion</li>
                <li>Sudden hearing loss in one ear</li>
                <li>New confusion, or a sharp change in memory over weeks rather than years</li>
                <li>Thoughts of harming yourself</li>
              </ul>
              <p><strong>In the US you can call or text 988 at any hour.</strong></p>
            </div>
          </details>

          <!-- Acknowledgement checkbox -->
          <label class="quiz-ack-row">
            <input type="checkbox" id="ack" class="quiz-checkbox" />
            <span
              >I have read the list above, none of it applies to me right now, and I understand this is a check-up and
              not a diagnosis.</span
            >
          </label>

          <!-- Disclaimer -->
          <p class="quiz-home-disclaimer">
            No account. No server. No analytics. You can delete everything with one button at the end.
          </p>

          <button class="quiz-btn-start" id="btn-start" disabled>
            Start the self-assessment
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M5 12h14M12 5l7 7-7 7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </button>
          <button class="quiz-btn-resume hidden" id="btn-resume">Continue where I left off</button>

          <div class="quiz-home-sponsor"><a href="/athena-evaluation" class="quiz-sponsor-link">Paid for by Athena Clinic</a></div>
        </div>
      </section>

      <!-- DOMAIN SECTIONS 0-5 -->
      <section class="quiz-screen" id="sc-dom0"><div id="dom0"></div></section>
      <section class="quiz-screen" id="sc-dom1"><div id="dom1"></div></section>
      <section class="quiz-screen" id="sc-dom2"><div id="dom2"></div></section>
      <section class="quiz-screen" id="sc-dom3"><div id="dom3"></div></section>
      <section class="quiz-screen" id="sc-dom4"><div id="dom4"></div></section>
      <section class="quiz-screen" id="sc-dom5"><div id="dom5"></div></section>

      <!-- RADIUS SECTION -->
      <section class="quiz-screen" id="sc-radius">
        <div class="quiz-section-intro">
          <p class="quiz-small" style="opacity:0.75">
            Everyone adjusts how they do things over time. Tell us where you are now. There are no wrong answers here. <strong
              >Answer from memory. Please do not try any of these out to find out, and never on your own.</strong>
          </p>
        </div>
        <div id="radlist"></div>
      </section>

      <!-- PRIORITY SECTION -->
      <section class="quiz-screen" id="sc-priority">
        <div class="quiz-section-intro">
          <p class="quiz-small" id="pri-intro"></p>
          <p class="quiz-priority-count" id="pri-count"></p>
        </div>
        <div id="prilist"></div>
      </section>

      <!-- RESULTS SECTION -->
      <section class="quiz-screen" id="sc-results">
        <!-- Panes — 3 only, trend removed -->
        <div class="quiz-pane on" id="pane-screen"></div>
        <div class="quiz-pane" id="pane-measured"></div>
        <div class="quiz-pane" id="pane-handoff"></div>

        <!-- Share card removed per request -->

        <p style="padding-bottom:80px"></p>
      </section>
    </main>

    <!-- ═══════════════════════════════════ BOTTOM NAV ════════════════════════════════ -->
    <nav class="quiz-nav hidden" id="nav" aria-label="Quiz navigation">
      <div class="quiz-nav-inner">
        <button class="quiz-nav-back hidden" id="btn-back" type="button">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path
              d="M19 12H5M12 5l-7 7 7 7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          Back
        </button>
        <a class="quiz-nav-continue hidden" id="btn-home" href="/">
          Home
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path
              d="M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9.5z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </a>
        <button class="quiz-nav-continue" id="btn-next" type="button">
          Next
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path
              d="M5 12h14M12 5l7 7-7 7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </button>
      </div>
    </nav>
  </div>

  <!-- Print-only summary — outside quiz-root so it is not hidden by it -->
  <div id="printable"></div>
</Layout>

<script>
  import '~/scripts/quiz';
</script>
