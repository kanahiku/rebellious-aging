---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import PodcastFilter from '~/components/widgets/PodcastFilter.astro';
import PodcastEpisodes from '~/components/widgets/PodcastEpisodes.astro';
import { site } from '~/config/site';
import { navigationData } from '~/data/navigation';
import { getImage } from 'astro:assets';
import podcastHero from '~/assets/images/podcast-hero.png';
import { getPodcastEpisodes, getBooks, groupEpisodesByPart } from '~/lib/content';

const metadata = {
  title: `Podcast | ${site.name}`,
  description:
    "Aging isn't a decline to manage. It's a chapter to author. Across 28 fearless episodes, we dismantle the stereotypes society hands us and reclaim every system of the body.",
  ignoreTitleTemplate: true,
};

const header = navigationData.header;
const heroPreload = await getImage({ src: podcastHero, width: 1920, format: 'webp' });

// ── Fetch from Sanity ─────────────────────────────────────────────────────────
const [allEpisodes, allBooks] = await Promise.all([getPodcastEpisodes(), getBooks()]);
const partGroups = groupEpisodesByPart(allEpisodes);

// Build a set of guidebook slugs so we can auto-derive book deep-links for
// episodes whose guidebookHref field hasn't been filled in Sanity yet.
const guidebookSlugs = new Set(
  allBooks.filter((b) => b.series === 'guidebook').map((b) => b.slug)
);

/** Return the /books deep-link for an episode.
 *  Priority: Sanity value (normalised) → auto-derived from slug match → bare /books.
 *
 *  Normalisation: GuideBookGrid sets id="book-{slug}" on every card, but Sanity
 *  editors sometimes store the anchor without the "book-" prefix
 *  (e.g. /books#hair instead of /books#book-hair). We fix that here. */
function guidebookLink(epSlug: string, sanityHref?: string): string {
  if (sanityHref?.startsWith('/books#')) {
    const anchor = sanityHref.slice('/books#'.length);
    // Ensure the "book-" prefix that GuideBookGrid uses for element IDs
    return anchor.startsWith('book-') ? sanityHref : `/books#book-${anchor}`;
  }
  if (sanityHref) return sanityHref; // non-/books# href — trust it as-is
  if (guidebookSlugs.has(epSlug)) return `/books#book-${epSlug}`;
  return '/books';
}

// ── Filter tabs (derived from parts) ─────────────────────────────────────────
const partSlugMap: Record<number, string> = {
  1: 'head-senses',
  2: 'core-vital',
  3: 'structural',
  4: 'reproductive',
  5: 'cellular',
};

const filterTabs = partGroups.map((g) => ({
  label: g.partName,
  id: partSlugMap[g.part] ?? `part-${g.part}`,
}));

// ── Alternate section tones ───────────────────────────────────────────────────
const tones: Array<'dark' | 'light'> = ['dark', 'light', 'dark', 'light', 'dark'];
---

<Layout metadata={metadata}>
  <link slot="head" rel="preload" as="image" href={heroPreload.src} fetchpriority="high" />
  <Fragment slot="header" />

  <Hero2
    variant="page"
    overlapHeader={false}
    withImage
    pageOverlay
    title="The Rebellious Aging Podcast"
    subtitle="Aging isn't a decline to manage. It's a chapter to author. Across 28 fearless episodes, we dismantle the stereotypes society hands us and reclaim every system of the body, from mitochondria to mindset. This is not gentle wellness. This is a community of rebels choosing strength, clarity, and vitality on our own terms."
    image={{
      ...podcastHero,
      alt: 'Older adults high-fiving on an indoor court',
    }}
  >
    <Header
      slot="nav"
      embedded
      isSticky={false}
      links={header.links}
      actions={header.actions}
    />
  </Hero2>

  <PodcastFilter
    id="roadmap"
    eyebrow="the roadmap"
    heading="Every system. Every stereotype. One by one."
    description="The full series rolls out over the coming months. Here's the incredible roadmap ahead, organized by the systems they reclaim. Subscribe on your platform of choice so you never miss a drop."
    tabs={filterTabs}
  />

  {partGroups.map((group, i) => (
    <PodcastEpisodes
      id={partSlugMap[group.part] ?? `part-${group.part}`}
      tone={tones[i] ?? 'light'}
      eyebrow={`${group.episodes.length} episode${group.episodes.length !== 1 ? 's' : ''}`}
      heading={group.partName}
      description={group.partDescription}
      episodes={group.episodes.map((ep) => ({
        slug: ep.slug,
        title: ep.title,
        tag: group.partName,
        description: ep.description,
        ctaText: 'Read the guidebook',
        ctaHref: guidebookLink(ep.slug, ep.guidebookHref),
        status: ep.status,
        spotifyUrl: ep.spotifyUrl,
        youtubeUrl: ep.youtubeUrl,
      }))}
    />
  ))}
</Layout>

<script>
  function scrollToHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (!target) return;
    const headerEl = document.getElementById('header');
    const offset = headerEl ? headerEl.offsetHeight + 24 : 112;
    const top = target.getBoundingClientRect().top + window.scrollY - offset;
    window.scrollTo({ top, behavior: 'smooth' });
  }

  // Hard load
  window.addEventListener('load', () => requestAnimationFrame(() => requestAnimationFrame(scrollToHash)), { once: true });

  // Astro view-transition: double-rAF ensures layout is fully calculated
  // after the DOM swap before we measure element positions.
  document.addEventListener('astro:after-swap', () =>
    requestAnimationFrame(() => requestAnimationFrame(scrollToHash))
  );
</script>
