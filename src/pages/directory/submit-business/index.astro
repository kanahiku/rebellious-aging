---
/**
 * /directory/submit-business — "List a business" (emails the client via the shared forms Worker).
 *
 * SECTION MAP
 * S1 DirectoryListingForm     modal-style card on a plain page: no hero, no nav, just the form
 */
import Layout from '~/layouts/Layout.astro';
import DirectoryListingForm from '~/components/widgets/DirectoryListingForm.astro';
import { collectTypes, getDirectoryBusinesses } from '~/lib/content/directory';

export const prerender = false;

const businesses = await getDirectoryBusinesses();
const categoryOptions = collectTypes(businesses).map((t) => t.value);

const metadata = {
  title: 'List a business | Directory | Rebellious Aging',
  description:
    'Tell us what you offer. We check every submission and only list things we would send our own family to.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <DirectoryListingForm kind="business" categoryOptions={categoryOptions} />
</Layout>
