---
/**
 * /directory/[slug] — one business's profile.
 *
 * SECTION MAP
 * S1 DirectoryProfile      name + short description + tags + story + details card (no hero; default site header)
 * S2 DirectoryRelated      "More like this" (auto: same type or location)
 * S3 DirectoryAddCta         links to the group + business forms
 */
import Layout from '~/layouts/PageLayout.astro';
import DirectoryProfile from '~/components/widgets/DirectoryProfile.astro';
import DirectoryRelated from '~/components/widgets/DirectoryRelated.astro';
import DirectoryAddCta from '~/components/widgets/DirectoryAddCta.astro';
import Header from '~/components/widgets/Header.astro';
import { getNavigationContent } from '~/lib/content';
import { getDirectoryBusinesses, getRelatedBusinesses, directoryPermalink } from '~/lib/content/directory';
import { absoluteUrl } from '~/config/schema/urls';

export const prerender = false;

const slug = Astro.params.slug;
const [all, nav] = await Promise.all([getDirectoryBusinesses(), getNavigationContent()]);
const business = all.find((b) => b.slug === slug);

if (!business) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const related = getRelatedBusinesses(business, all, 3);
const path = directoryPermalink(business.slug);

Astro.locals.jsonLdNodes = [
  {
    '@type': 'LocalBusiness',
    '@id': `${absoluteUrl(path)}#business`,
    name: business.name,
    description: business.shortDescription,
    url: absoluteUrl(path),
    ...(business.phone ? { telephone: business.phone } : {}),
    ...(business.website ? { sameAs: [business.website] } : {}),
    ...(business.image?.src ? { image: business.image.src } : {}),
    address: {
      '@type': 'PostalAddress',
      addressLocality: business.locations[0],
      addressRegion: 'HI',
      addressCountry: 'US',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Directory', item: absoluteUrl('/directory') },
      { '@type': 'ListItem', position: 3, name: business.name, item: absoluteUrl(path) },
    ],
  },
];

const metadata = {
  title: `${business.name} | Directory | Rebellious Aging`,
  description: business.shortDescription,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header"></Fragment>
  <div class="w-full bg-page">
    <div class="mx-auto w-full max-w-container px-5 py-6 sm:px-8 md:px-16 lg:px-[120px] lg:py-8">
      <Header embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
    </div>
  </div>
  <DirectoryProfile business={business} />
  <DirectoryRelated businesses={related} />
  <DirectoryAddCta />
</Layout>
