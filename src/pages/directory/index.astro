---
/**
 * /directory — every business in one list, with Type + Location filters and search.
 *
 * SECTION MAP
 * S1 Hero2 variant="page"     same hero + embedded nav as the other pages
 * S2 DirectoryList          filters + cards (Sanity `directoryBusiness`)
 * S3 DirectoryAddCta          links to the group + business forms
 */
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import DirectoryList from '~/components/widgets/DirectoryList.astro';
import DirectoryAddCta from '~/components/widgets/DirectoryAddCta.astro';
import { getNavigationContent } from '~/lib/content';
import { getDirectoryBusinesses } from '~/lib/content/directory';

export const prerender = false;

const [businesses, nav] = await Promise.all([getDirectoryBusinesses(), getNavigationContent()]);

const metadata = {
  title: 'Directory: places to show up on Oʻahu | Rebellious Aging',
  description: 'Groups, classes, markets and clinics that help you do the basics. Pick one, check the day, and go.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header"></Fragment>

  <Hero2
    variant="page"
    overlapHeader={false}
    title="Places to show up on Oʻahu"
    subtitle="Groups, classes, markets and clinics that help you do the basics. Pick one, check the day, and go."
  >
    <Header slot="nav" embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
  </Hero2>

  <DirectoryList businesses={businesses} />
  <DirectoryAddCta />
</Layout>
