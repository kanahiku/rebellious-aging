---
/**
 * /directory — every business in one list, with Type + Location filters and search.
 *
 * SECTION MAP
 * S1 Hero2 variant="page"     same hero + embedded nav as the other pages
 * S2 DirectoryList          filters + cards (Sanity `directoryBusiness`)
 * S3 DirectoryAddCta          links to the business form
 */
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import DirectoryList from '~/components/widgets/DirectoryList.astro';
import DirectoryAddCta from '~/components/widgets/DirectoryAddCta.astro';
import { getDirectoryPageContent, getNavigationContent } from '~/lib/content';
import { getDirectoryBusinesses } from '~/lib/content/directory';

export const prerender = false;

const [businesses, nav, page] = await Promise.all([
  getDirectoryBusinesses(),
  getNavigationContent(),
  getDirectoryPageContent(),
]);
const { hero, intro } = page;

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header"></Fragment>

  <Hero2
    variant="page"
    overlapHeader={false}
    withImage
    pageOverlay
    image={hero.image}
    title={hero.title}
    subtitle={hero.subtitle}
  >
    <Header slot="nav" embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
  </Hero2>

  <DirectoryList businesses={businesses} lede={intro.lede} />
  <DirectoryAddCta />
</Layout>
