---
import Layout from '~/layouts/PageLayout.astro';
import DecadeHero from '~/components/widgets/DecadeHero.astro';
import DecadeSplitTable from '~/components/widgets/DecadeSplitTable.astro';
import DecadeBulletSplit from '~/components/widgets/DecadeBulletSplit.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { site } from '~/config/site';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';

const metadata = {
  title: `70 and beyond | ${site.name}`,
  description: "Protect your independence. You can change how fast you decline. You can't climb back up.",
  ignoreTitleTemplate: true,
};

const likelyWeakestLinks = [
  { name: 'Balance', description: 'A fall is the most common Black Swan.' },
  { name: 'Strength', description: 'Getting up from a chair or off the floor without help.' },
  { name: 'Isolation', description: "When nobody notices you've stopped showing up." },
];

const atHomeChecks = [
  { name: 'Blood pressure', description: 'Home cuff, seated, after five minutes of rest.' },
  { name: 'Grip strength', description: 'A hand grip meter.' },
  { name: '5× sit-to-stand', description: 'Five times, arms crossed. Time it.' },
  { name: 'Balance', description: 'One leg, eyes open. Count the seconds.' },
  { name: 'Weight & waist', description: 'Waist measured at the belly button.' },
];

const homeBullets = [
  'Practice balance every day.',
  'Clear the floor: loose rugs, cords, clutter.',
  'Light the path from bed to bathroom.',
  'Put grab bars in the shower and by the toilet.',
  'Get your eyes and hearing checked every year.',
  'Ask your doctor which of your medications can make you dizzy.',
  "Stay connected. Someone should notice if you don't show up.",
];
---

<Layout metadata={metadata}>
  <Fragment slot="header" />

  <DecadeHero
    eyebrow="Start with your decade"
    heading="70 and beyond."
    description="Protect your independence. You can change how fast you decline. You can't climb back up."
    ctaText={PRIMARY_CTA_LABEL}
    ctaHref={PRIMARY_CTA_HREF}
  />

  <DecadeSplitTable
    id="where-you-are"
    leftEyebrow="Where you are on the curve"
    leftText="Every bit of reserve counts double now, because there's less time to rebuild what you lose. The goal is simple: stay in your own home, on your own terms."
    rightEyebrow="Your likely weakest links"
    rows={likelyWeakestLinks}
  />

  <DecadeSplitTable
    id="what-to-fill-first"
    leftEyebrow="What to fill first"
    leftText="Balance practice every day. Strength work twice a week. Stay connected, so someone notices if you don't show up."
    leftTone="heading"
    rightEyebrow="At-home checks"
    rows={atHomeChecks}
    note="If a number drops fast, tell your doctor. Don't wait for the next checkup."
    bgClass="bg-white"
  />

  <DecadeBulletSplit
    id="staying-home"
    heading="Staying in your home"
    lead="Most Black Swans start with a fall."
    body="About one in four adults over 65 falls each year. Most falls happen at home, and most are preventable."
    source="CDC"
    bullets={homeBullets}
  />

  <CTABanner
    title="Find out where you stand."
    subtitle="Ten minutes, free, and nothing you enter leaves your browser. Then fill the first bucket."
    ctaText={PRIMARY_CTA_LABEL}
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Book an Athena evaluation"
    secondaryCtaHref="/athena-evaluation"
  />
</Layout>
