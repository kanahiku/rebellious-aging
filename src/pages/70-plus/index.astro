---
import Layout from '~/layouts/PageLayout.astro';
import DecadeSections from '~/components/widgets/DecadeSections.astro';
import { getDecadeContent } from '~/lib/content';

/** /70-plus. All copy comes from the Sanity `decadePage` document `decade-70-plus`. */
const page = await getDecadeContent('70-plus');

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header" />
  <DecadeSections page={page} />
</Layout>
