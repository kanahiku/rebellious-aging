---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import MeasurementTable from '~/components/widgets/MeasurementTable.astro';
import TalkToDoctor from '~/components/widgets/TalkToDoctor.astro';
import ContentBand from '~/components/widgets/ContentBand.astro';
import { site } from '~/config/site';
import { navigationData } from '~/data/navigation';
import { getImage } from 'astro:assets';
import talkToDoctorHero from '~/assets/images/talk-to-doctor-hero.png';

const metadata = {
  title: `Ask Your Doctor | ${site.name}`,
  description:
    'You have done what you can do alone. Past this point it is medical care. Walk into that appointment with a much better list.',
  ignoreTitleTemplate: true,
};

const header = navigationData.header;
const heroPreload = await getImage({ src: talkToDoctorHero, width: 1920, format: 'webp' });

const capsuleSvg = `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.678 10.677C8.251 13.104 6.357 15.086 4.889 16.682C3.432 18.266 2.705 20.045 2.668 21.737C2.632 23.414 3.27 25.114 4.745 26.589C6.22 28.064 7.919 28.702 9.597 28.666C11.289 28.629 13.068 27.901 14.652 26.445C16.248 24.977 18.229 23.084 20.656 20.656L10.678 10.677ZM28.474 2.859C26.516 0.901 24.126 -0.051 21.679 0.002C19.247 0.055 16.867 1.097 14.877 2.926C13.25 4.423 11.242 6.342 8.792 8.792C6.342 11.242 4.423 13.25 2.926 14.877C1.097 16.867 0.055 19.247 0.002 21.679C-0.051 24.126 0.901 26.516 2.859 28.474C4.818 30.433 7.207 31.385 9.654 31.332C12.087 31.279 14.467 30.237 16.457 28.407C18.084 26.911 20.092 24.992 22.542 22.542C24.992 20.092 26.911 18.084 28.407 16.457C30.237 14.467 31.279 12.087 31.332 9.654C31.385 7.207 30.433 4.818 28.474 2.859Z" fill="currentColor"/></svg>`;

const documentSvg = `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M28.04 13.76H18.24C17.349 13.76 16.494 13.406 15.864 12.776C15.234 12.146 14.88 11.291 14.88 10.4V0.6C14.88 0.526 14.851 0.455 14.798 0.402C14.745 0.349 14.674 0.32 14.6 0.32H8.16C6.972 0.32 5.832 0.792 4.992 1.632C4.152 2.472 3.68 3.612 3.68 4.8V27.2C3.68 28.388 4.152 29.528 4.992 30.368C5.832 31.208 6.972 31.68 8.16 31.68H23.84C25.028 31.68 26.168 31.208 27.008 30.368C27.848 29.528 28.32 28.388 28.32 27.2V14.04C28.32 13.966 28.291 13.895 28.238 13.842C28.186 13.79 28.114 13.76 28.04 13.76ZM21.6 24.96H10.4C10.103 24.96 9.818 24.842 9.608 24.632C9.398 24.422 9.28 24.137 9.28 23.84C9.28 23.543 9.398 23.258 9.608 23.048C9.818 22.838 10.103 22.72 10.4 22.72H21.6C21.897 22.72 22.182 22.838 22.392 23.048C22.602 23.258 22.72 23.543 22.72 23.84C22.72 24.137 22.602 24.422 22.392 24.632C22.182 24.842 21.897 24.96 21.6 24.96ZM21.6 19.36H10.4C10.103 19.36 9.818 19.242 9.608 19.032C9.398 18.822 9.28 18.537 9.28 18.24C9.28 17.943 9.398 17.658 9.608 17.448C9.818 17.238 10.103 17.12 10.4 17.12H21.6C21.897 17.12 22.182 17.238 22.392 17.448C22.602 17.658 22.72 17.943 22.72 18.24C22.72 18.537 22.602 18.822 22.392 19.032C22.182 19.242 21.897 19.36 21.6 19.36Z" fill="currentColor"/><path d="M27.424 11.281L17.358 1.215C17.339 1.195 17.314 1.182 17.287 1.177C17.26 1.172 17.231 1.174 17.206 1.185C17.18 1.195 17.159 1.213 17.143 1.236C17.128 1.259 17.12 1.286 17.119 1.314V10.4C17.119 10.697 17.238 10.982 17.447 11.192C17.658 11.402 17.942 11.52 18.239 11.52H27.326C27.353 11.52 27.38 11.511 27.403 11.496C27.426 11.481 27.444 11.459 27.454 11.433C27.465 11.408 27.468 11.38 27.462 11.353C27.457 11.325 27.444 11.301 27.424 11.281Z" fill="currentColor"/></svg>`;

// Remaining advice items (deprescribing + two tests)
const adviceItems = [
  {
    iconSvg: capsuleSvg,
    title: 'Ask about deprescribing',
    body: 'Do you still need all of these? A statin started at seventy takes years to pay off while the side effects start now. Aspirin is genuinely valuable for some people and a bleeding risk for many. The risk-benefit that made sense a decade ago may not be the one you are living in. This is a question almost nobody asks their doctor, and it is one of the most useful ones available.',
  },
  {
    iconSvg: documentSvg,
    title: 'Two tests to discuss before you take them',
    body: 'A multi-cancer early detection blood test can find things nothing else would. It can also make you uninsurable for long-term care. You cannot unknow a result, and a pre-existing condition is a pre-existing condition. Get your financial plans in place first. Whole-body MRI has its own version of this problem: it finds a great deal, not all of it meaningful.',
  },
];
---

<Layout metadata={metadata}>
  <link slot="head" rel="preload" as="image" href={heroPreload.src} fetchpriority="high" />
  <Fragment slot="header" />

  <Hero2
    variant="page"
    overlapHeader={false}
    withImage
    pageOverlay
    title="Talk to your<br />doctor about it"
    subtitle="You have done what you can do alone, and what you can do with a friend. Past this point it is medical care, and we do not deliver medical care. What we can do is make sure you walk into that appointment with a much better list."
    image={{
      ...talkToDoctorHero,
      alt: 'A stethoscope resting on a tan medical case',
    }}
  >
    <Header
      slot="nav"
      embedded
      isSticky={false}
      links={header.links}
      actions={header.actions}
    />
  </Hero2>

  {/* ── Measurement table — replaces "What only a doctor can measure" ── */}
  <MeasurementTable
    id="what-to-measure"
    eyebrow="Bucket 2 · Ask your doctor"
    heading="You don't know what you don't know."
    body="Most of what decides how fast you decline is silent. You can't feel your blood pressure, your blood sugar or your bone density. You have to measure them. Some of it you can check at home tonight. The rest your doctor orders."
    leftHeading="Check at home"
    leftRows={[
      { name: 'Blood pressure',  description: 'A home cuff, seated, after five minutes of rest.' },
      { name: 'Grip strength',   description: 'A hand grip meter. Weak grip is an early sign of muscle loss.' },
      { name: '5× sit-to-stand', description: 'Stand up from a chair five times with your arms crossed. Time it.' },
      { name: 'Balance',         description: 'Stand on one leg, eyes open. Count the seconds.' },
      { name: 'Weight & waist',  description: 'Weigh yourself. Measure your waist at the belly button.' },
    ]}
    rightHeading="Doctor orders"
    rightRows={[
      { name: 'A1c (blood sugar)',  description: 'Your average blood sugar over the last three months.' },
      { name: 'Cholesterol',        description: 'A standard lipid panel.' },
      { name: 'Kidney & liver',     description: 'Blood and urine tests that catch silent damage early.' },
      { name: 'Bone density',       description: 'A DEXA scan.' },
      { name: 'Coronary calcium',   description: "A quick CT scan that shows plaque in your heart's arteries." },
      { name: 'Hearing',            description: 'A hearing test. Hearing loss speeds up cognitive decline.' },
      { name: 'Medication review',  description: 'Do you still need everything you take?' },
    ]}
  />

  {/* ── Deprescribing + Two tests + Disclosure — no packages ── */}
  <TalkToDoctor
    items={adviceItems}
    packages={[]}
    disclosure="Dr. Peterson owns Athena Clinic. Everything on this page works exactly as well with your own physician, and we would rather you went to whoever knows your history. If you want it done by his team, that option is below."
  />

  {/* ── Get it measured — after Disclosure ── */}
  <ContentBand
    id="get-it-measured"
    heading="Get it measured."
    paragraphs={[
      "Athena Clinic can run every test on this page in one evaluation, review your self-assessment and give you a plan.",
      "Or bring this list to your own doctor. Everything here works just as well with someone who knows your history.",
    ]}
    cta={{ text: "Book an Athena evaluation", href: "/athena-evaluation" }}
  />

</Layout>
