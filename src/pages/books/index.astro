---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import BooksGrid from '~/components/widgets/BooksGrid.astro';
import BookSeriesFeature from '~/components/widgets/BookSeriesFeature.astro';
import GuideBookGrid from '~/components/widgets/GuideBookGrid.astro';
import { site } from '~/config/site';
import { navigationData } from '~/data/navigation';
import { getBooks, getPodcastEpisodes } from '~/lib/content';

const metadata = {
  title: `Books | ${site.name}`,
  description:
    'Books by Dr. Robert Peterson MD, organized across three series: foundational textbooks, the Rebellious Aging Guidebooks, and Bargaining with Aging.',
  ignoreTitleTemplate: true,
};

const header = navigationData.header;
const booksHero = {
  src: 'https://images.unsplash.com/photo-1546350882-6f047ea47789?auto=format&fit=crop&w=2400&q=85',
  alt: 'An open book and coffee on a white surface',
};
const [books, allEpisodes] = await Promise.all([getBooks(), getPodcastEpisodes()]);

// Build a reverse map: book slug → episode slug.
// Episodes store guidebookHref = "/books#<book-slug>" (e.g. "/books#hair").
// We invert that so we can answer "which episode goes with book slug X?"
// This is the canonical cross-reference because editors maintain it on the
// episode side, and it's where the correct book slug lives.
const episodeByBookSlug = new Map<string, string>();
for (const ep of allEpisodes) {
  if (ep.guidebookHref?.startsWith('/books#')) {
    const anchor = ep.guidebookHref.slice('/books#'.length);
    // anchor may or may not have the "book-" prefix — strip it for comparison
    const bookSlug = anchor.startsWith('book-') ? anchor.slice('book-'.length) : anchor;
    episodeByBookSlug.set(bookSlug, ep.slug);
  }
}

// Direct episode slug set for the simple-match fallback
const episodeSlugs = new Set(allEpisodes.map((ep) => ep.slug));

/** Return the podcast deep-link for a book.
 *  Priority:
 *   1. Reverse-lookup via episode's guidebookHref (most reliable — editors set this)
 *   2. Sanity's podcastHref on the book (kept for edge cases but often has wrong slug)
 *   3. Direct slug match fallback */
function podcastLink(book: (typeof books)[number]): string | undefined {
  // 1. Reverse lookup: find the episode that claims this book
  const epSlug = episodeByBookSlug.get(book.slug);
  if (epSlug) return `/podcast#${epSlug}`;
  // 2. Sanity's podcastHref (may have an incorrect episode slug set by editors)
  if (book.podcastHref) return book.podcastHref;
  // 3. Direct slug match (same slug on both sides)
  if (episodeSlugs.has(book.slug)) return `/podcast#${book.slug}`;
  return undefined;
}

const guidebookBooks = books.filter((book) => book.series === 'guidebook');
const textbook = books.find((book) => book.series === 'textbook');
const bargaining = books.find((book) => book.series === 'bargaining');

const toFeature = (book?: (typeof books)[number]) =>
  book
    ? {
        slug: book.slug,
        title: book.title,
        subtitle: book.subtitle,
        description: book.description ?? '',
        image: book.image,
        tags: book.badges,
        buyButtons: book.ctas,
        publisherNote: book.publisherNote,
        podcastHref: podcastLink(book),
      }
    : undefined;

const textbookBook = toFeature(textbook);
const bargainingBook = toFeature(bargaining);

const guideBooks = guidebookBooks.map((book) => ({
  slug: book.slug,
  title: book.title,
  subtitle: book.subtitle,
  description: book.description,
  image: book.image,
  tags: book.badges,
  buyButtons: book.ctas,
  publisherNote: book.publisherNote,
  podcastHref: podcastLink(book),
}));
---

<Layout metadata={metadata}>
  <link slot="head" rel="preload" as="image" href={booksHero.src} fetchpriority="high" />
  <Fragment slot="header"></Fragment>

  <!-- Hero — image background, "Books by Dr. Robert Peterson MD" -->
  <Hero2
    variant="page"
    stacked
    overlapHeader={false}
    withImage
    pageOverlay
    title="Books by <br />Dr. Robert Peterson MD"
    subtitle="Organized across three series: foundational textbooks, the Rebellious Aging Guidebooks, and Bargaining with Aging."
    image={booksHero}
  >
    <Header slot="nav" embedded isSticky={false} links={header.links} actions={header.actions} />
  </Hero2>

  <!-- Books with filter tabs + grid -->
  <BooksGrid id="books-grid" books={books} />

  <!-- Textbook Series — dark gradient, featured book -->
  <BookSeriesFeature
    id="textbook-series"
    eyebrow="Series"
    heading="Textbook Series"
    description="Foundational, evidence-based references for clinicians and serious students of longevity medicine."
    book={textbookBook}
  />

  <!-- Rebellious Aging Guidebook Series — light grid of book cards -->
  <GuideBookGrid
    id="guidebook-series"
    eyebrow="Series"
    heading="Rebellious Aging Guidebook Series"
    description="A twenty-eight-part series, one guidebook per part of the body, offering practical, evidence-based guides for living long and well on your own terms."
    books={guideBooks}
  />

  <!-- Bargaining with Aging Series — dark gradient, rounded bottom, featured book -->
  <BookSeriesFeature
    id="bargaining-series"
    eyebrow="Series"
    heading="Bargaining with Aging Series"
    description="Honest reckonings with the trade-offs, risks, and unknowns of growing older."
    book={bargainingBook}
  />
</Layout>

<script>
  function scrollToHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (!target) return;
    const headerEl = document.getElementById('header');
    const offset = headerEl ? headerEl.offsetHeight + 24 : 112;
    const top = target.getBoundingClientRect().top + window.scrollY - offset;
    window.scrollTo({ top, behavior: 'smooth' });
  }

  // Hard load
  window.addEventListener('load', () => requestAnimationFrame(() => requestAnimationFrame(scrollToHash)), {
    once: true,
  });

  // Astro view-transition: double-rAF ensures layout is fully calculated
  // after the DOM swap before we measure element positions.
  document.addEventListener('astro:after-swap', () => requestAnimationFrame(() => requestAnimationFrame(scrollToHash)));
</script>
