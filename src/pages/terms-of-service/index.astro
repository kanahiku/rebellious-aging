---
import Layout from '~/layouts/PageLayout.astro';
import LegalDoc from '~/components/widgets/LegalDoc.astro';
import LegalBody from '~/components/widgets/LegalBody.astro';
import { getLegalContent } from '~/lib/content';
import { fillTokens, legalVars } from '~/utils/legalVars';

/** /terms-of-service. All copy comes from the Sanity `legalPage` document `legal-terms-of-service`. */
const page = await getLegalContent('terms-of-service');
const vars = legalVars();

const metadata = {
  title: fillTokens(page.meta.title, vars),
  description: fillTokens(page.meta.description, vars),
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header"></Fragment>
  <LegalDoc title={page.title}>
    <LegalBody sections={page.sections} vars={vars} />
  </LegalDoc>
</Layout>
