---
/*
 * The Ohana page — Figma node 310:926
 *
 * All copy and images come from the Sanity `ohanaPage` singleton.
 * Kept in code on purpose: section order/layout, the dark/outlined styling of the two
 * "alone / together" cards (by position), the join form's field labels, and the testimonials
 * (which come from the Testimonial documents).
 *
 * SECTION MAP
 * S1  310:927  Hero2 variant="title"
 * S2  310:941  TextSplit — "You get old alone." + body + CTA
 * S3  310:1235 StatsBand — 3 stats
 * S4  310:1292 EditorialWithImage — "Loneliness…" + full-bleed img + "Three of the nine."
 * S5  310:1319 ImageCardGrid — Belong / Loved Ones First / Right Tribe
 * S6a 310:1416 TextSplit — "Okinawa calls it a moai." (heading left, body right)
 * S6b 310:1424 TextSplit reversed — body left + "Information is not an adherence mechanism." right
 * S6c 310:1430 DuoCards — "The other three, alone" + "The other three, together"
 * S7  310:1447 OhanaActivities — "What an Ohana actually does."
 * S8  310:1550 PurposeBanner — "Purpose is a longevity drug." + "No chapter near you?"
 * S9  310:1562 Testimonials tone="light" — "From the Ohana"
 * S10 310:1601 TextSplit — "Come home." + body + 2 CTAs
 * S11 310:1019 Footer
 */

import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StatsBand from '~/components/widgets/StatsBand.astro';
import EditorialWithImage from '~/components/widgets/EditorialWithImage.astro';
import ImageCardGrid from '~/components/widgets/ImageCardGrid.astro';
import DuoCards from '~/components/widgets/DuoCards.astro';
import OhanaActivities from '~/components/widgets/OhanaActivities.astro';
import PurposeBanner from '~/components/widgets/PurposeBanner.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import OhanaJoinForm from '~/components/widgets/OhanaJoinForm.astro';
import Button from '~/components/ui/Button.astro';
import Text from '~/components/ui/Text.astro';
import Image from '~/components/common/Image.astro';
import {
  formatTestimonialAttribution,
  getNavigationContent,
  getOhanaContent,
  getTestimonials,
} from '~/lib/content';
import { cmsHeading } from '~/utils/cmsText';

const [page, nav, testimonials] = await Promise.all([getOhanaContent(), getNavigationContent(), getTestimonials()]);
const { hero, intro, loneliness, blueZones, moai, activities, purpose, community, comeHome } = page;

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
};

// Card styling is fixed by position: 1 = dark, 2 = outlined.
const duoVariants = ['dark', 'outlined'] as const;
const duoCards = moai.duoCards.slice(0, duoVariants.length).map((card, i) => ({
  ...card,
  variant: duoVariants[i]!,
}));

const blueZonesCards = blueZones.cards.map((card) => ({
  eyebrow: card.eyebrow,
  heading: card.heading,
  body: card.body,
  imageAspect: '378 / 252',
  imageSrc: card.image?.src,
  imageAlt: card.image?.alt ?? '',
}));
---

<Layout metadata={metadata}>
  {hero.image?.src && <link slot="head" rel="preload" as="image" href={hero.image.src} fetchpriority="high" />}
  <Fragment slot="header"></Fragment>
  <Hero2
    id="ohana-hero"
    variant="title"
    height="page"
    title={hero.title}
    overlapHeader={false}
    image={hero.image}
    imageMobile={hero.imageMobile}
  >
    <Header slot="nav" embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
  </Hero2>

  {/* S2 — Intro text split: heading left, body + CTA right */}
  <TextSplit id="ohana-intro" heading={intro.heading}>
    <Text>{intro.body}</Text>
    <Button variant="link" text={intro.ctaText} href={intro.ctaHref} class="mt-8" />
  </TextSplit>

  {/* S3 — Stats band */}
  <StatsBand id="ohana-stats" stats={intro.stats} />

  {/* S4 — Editorial with full-bleed image */}
  <EditorialWithImage id="loneliness" heading={loneliness.heading} pullQuote={loneliness.pullQuote}>
    <Fragment slot="body">
      {loneliness.body.map((paragraph) => <Text>{paragraph}</Text>)}
    </Fragment>
    <Fragment slot="caption">
      {loneliness.caption.map((paragraph) => <Text>{paragraph}</Text>)}
    </Fragment>
    {
      loneliness.image?.src && (
        <Image
          slot="image"
          src={loneliness.image.src}
          alt={loneliness.image.alt}
          class="w-full object-cover"
          style="aspect-ratio: 1440 / 511; object-position: center 30%;"
          layout="none"
          widths={[640, 828, 1200, 1440]}
          sizes="100vw"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </EditorialWithImage>

  {/* S5 — Blue Zones: Belong / Loved Ones First / Right Tribe */}
  <ImageCardGrid id="blue-zones" cards={blueZonesCards} footerNote={blueZones.footerNote} />

  {
    /* S6 — Moai + Adherence + DuoCards — bg wraps all three
       Wrapper owns all vertical spacing: py-120px outer, gap-72px between sections */
  }
  <div class="bg-[#e7dfd1]">
    <div class="flex flex-col gap-12 py-12 md:gap-16 md:py-16 lg:gap-[72px] lg:py-[120px]">
      {/* S6a — Moai: heading left, body right */}
      <TextSplit id="moai" noPadY headingHtml={cmsHeading(moai.moaiHeading)}>
        {moai.moaiBody.map((paragraph, i) => <Text class={i > 0 ? 'mt-[1lh]' : undefined}>{paragraph}</Text>)}
      </TextSplit>

      {/* S6b — Information: body left, large heading right (reversed) */}
      <TextSplit id="adherence" noPadY headingHtml={cmsHeading(moai.adherenceHeading)} reversed>
        {moai.adherenceBody.map((paragraph, i) => <Text class={i > 0 ? 'mt-[1lh]' : undefined}>{paragraph}</Text>)}
      </TextSplit>

      {/* S6c — DuoCards: alone vs together */}
      <DuoCards id="alone-vs-together" cards={duoCards} noPadY />
    </div>
  </div>

  {/* S7 — What an Ohana actually does */}
  <OhanaActivities
    id="ohana-activities"
    heading={activities.heading}
    subtitle={activities.subtitle}
    activities={activities.items}
  >
    {
      activities.image?.src && (
        <Image
          slot="image"
          src={activities.image.src}
          alt={activities.image.alt}
          class="w-full rounded-[16px] object-cover"
          style="aspect-ratio: 568 / 368;"
          layout="none"
          widths={[400, 568, 828, 1024]}
          sizes="(max-width: 768px) 100vw, 568px"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </OhanaActivities>

  {/* S8 — Purpose banner + No chapter near you */}
  <PurposeBanner id="purpose" purposeHeading={purpose.heading} noChapterHeading={purpose.noChapterHeading}>
    <a
      slot="no-chapter-cta"
      href={purpose.noChapterLinkHref}
      class="font-sans font-semibold text-[14px] md:text-[15px] underline-offset-2 transition-colors duration-200 hover:underline"
      style="color: var(--aw-color-bg-page);">{purpose.noChapterLinkText}</a
    >
    {
      purpose.image?.src && (
        <Image
          slot="bg"
          src={purpose.image.src}
          alt={purpose.image.alt}
          class="absolute inset-0 size-full object-cover"
          layout="none"
          widths={[640, 828, 1200, 1440]}
          sizes="100vw"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      )
    }
    <Fragment slot="purpose-body">
      {purpose.body.map((paragraph, i) => <Text class={i > 0 ? 'mt-[1lh]' : undefined}>{paragraph}</Text>)}
    </Fragment>
    <Fragment slot="no-chapter-body">
      {
        purpose.noChapterBody.map((paragraph, i) => (
          <Text color="inherit" class={i > 0 ? 'mt-[1lh] text-page/80' : 'text-page/80'}>
            {paragraph}
          </Text>
        ))
      }
    </Fragment>
  </PurposeBanner>

  {/* S9 — Testimonials: light tone */}
  <Testimonials
    id="from-the-ohana"
    eyebrow={community.testimonialsEyebrow}
    heading={community.testimonialsHeading}
    tone="light"
    testimonials={testimonials.map((item) => ({
      testimonial: item.quote,
      name: formatTestimonialAttribution(item),
    }))}
  />

  {/* S10a — Ohana join form — #join anchor, just above "Come home." */}
  <OhanaJoinForm
    id="join"
    eyebrow={community.joinEyebrow}
    heading={community.joinHeading}
    description={community.joinDescription}
  />

  {/* S10 — Come home CTA — two buttons side by side */}
  <TextSplit id="come-home" heading={comeHome.heading} compact>
    <Text>{comeHome.body}</Text>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button variant="primary" text={comeHome.primaryText} href={comeHome.primaryHref} target="_blank" hideNote />
      <Button variant="ghost" tone="light" text={comeHome.secondaryText} href={comeHome.secondaryHref} hideNote />
    </div>
  </TextSplit>
</Layout>
