---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import CredentialsSection from '~/components/widgets/CredentialsSection.astro';
import PublicationsSection from '~/components/widgets/PublicationsSection.astro';
import Text from '~/components/ui/Text.astro';
import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';
import { getAboutContent, getNavigationContent } from '~/lib/content';
import { cmsInline } from '~/utils/cmsText';

/**
 * /about. All copy and images come from the Sanity `aboutPage` singleton.
 * Layout, icons and section order stay in code.
 */
const [page, nav] = await Promise.all([getAboutContent(), getNavigationContent()]);
const { hero, movement, doctor, credentials, publications, sponsor } = page;

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  {hero.image?.src && <link slot="head" rel="preload" as="image" href={hero.image.src} fetchpriority="high" />}
  <Fragment slot="header" />
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline={hero.tagline}
    title={cmsInline(hero.title)}
    content={hero.content}
    image={hero.image}
  >
    <Header slot="nav" embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
  </Hero2>

  <TextSplit id="movement" eyebrow={movement.eyebrow} headingHtml={cmsInline(movement.heading)} compact>
    <Text variant="body-lg">{movement.lede}</Text>
    <Text class="mt-4">{movement.body}</Text>
    <Button variant="primary" text={movement.ctaText} href={movement.ctaHref} hideNote class="mt-6 self-start" />
  </TextSplit>

  <TextSplit
    id="guiding-principle"
    eyebrow={doctor.eyebrow}
    heading={doctor.heading}
    compact
    alignTop
    class="bg-white"
  >
    {doctor.paragraphs.map((paragraph, i) => <Text class={i > 0 ? 'mt-4' : undefined}>{paragraph}</Text>)}
    <Heading variant="h3" as="p" class="mt-8 !text-[30px]">
      {doctor.quote}
    </Heading>
    <Text class="mt-3">{doctor.quoteAuthor}</Text>
  </TextSplit>

  {/* ── Medical Credentials / Journey ── */}
  <CredentialsSection
    id="credentials"
    eyebrow={credentials.eyebrow}
    heading={credentials.heading}
    educationLabel={credentials.educationLabel}
    education={credentials.education}
    certificationsLabel={credentials.certificationsLabel}
    certifications={credentials.certifications}
    residenciesLabel={credentials.residenciesLabel}
    residencies={credentials.residencies}
  />

  {/* ── Publications ── */}
  <PublicationsSection
    id="publications"
    eyebrow={publications.eyebrow}
    heading={publications.heading}
    publications={publications.items}
  />

  <TextSplit id="sponsor" eyebrow={sponsor.eyebrow} heading={sponsor.heading} compact alignTop class="bg-page">
    <div class="rounded-[32px] bg-section-grey p-6 md:p-8">
      <Heading variant="h4">{sponsor.disclosureHeading}</Heading>
      <Text class="mt-4">{sponsor.body}</Text>
      <a href={sponsor.linkHref} class="btn-link mt-5">{sponsor.linkText}</a>
    </div>
  </TextSplit>
</Layout>
