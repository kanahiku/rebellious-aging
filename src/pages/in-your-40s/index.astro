---
import Layout from '~/layouts/PageLayout.astro';
import DecadeHero from '~/components/widgets/DecadeHero.astro';
import DecadeSplitTable from '~/components/widgets/DecadeSplitTable.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { site } from '~/config/site';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';

const metadata = {
  title: `In your 40s | ${site.name}`,
  description:
    "The slope has started. You probably can't feel it, which is exactly why this is the decade to measure.",
  ignoreTitleTemplate: true,
};

const likelyWeakestLinks = [
  { name: 'Blood pressure', description: 'The most common silent climb of this decade.' },
  { name: 'Blood sugar', description: 'Weight around the middle and a rising A1c often show up here.' },
  { name: 'Sleep', description: 'Stress, and for many women, perimenopause.' },
];

const atHomeChecks = [
  { name: 'Blood pressure', description: 'Home cuff, seated, after five minutes of rest.' },
  { name: 'Grip strength', description: 'A hand grip meter.' },
  { name: '5× sit-to-stand', description: 'Five times, arms crossed. Time it.' },
  { name: 'Balance', description: 'One leg, eyes open. Count the seconds.' },
  { name: 'Weight & waist', description: 'Waist measured at the belly button.' },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header" />

  <DecadeHero
    eyebrow="Start with your decade"
    heading="In your 40s."
    description="The slope has started. You probably can't feel it, which is exactly why this is the decade to measure."
    ctaText={PRIMARY_CTA_LABEL}
    ctaHref={PRIMARY_CTA_HREF}
  />

  <DecadeSplitTable
    id="where-you-are"
    leftEyebrow="Where you are on the curve"
    leftText={[
      'Muscle and bone are slowly declining. Blood pressure, blood sugar and weight tend to creep up a little each year. None of it hurts. All of it adds up.',
      "Accept it: Your close-up vision will start to go. Accept it. That isn't the one to worry about.",
    ]}
    rightEyebrow="Your likely weakest links"
    rows={likelyWeakestLinks}
  />

  <DecadeSplitTable
    id="what-to-fill-first"
    leftEyebrow="What to fill first"
    leftText="Keep strength training. It's what slows muscle loss. Watch your waist more than your weight. Guard your sleep. If work pushed your friends off the calendar, put one back."
    leftTone="heading"
    rightEyebrow="At-home checks"
    rows={atHomeChecks}
    note="Check once a year, same time each year, so you can see the trend."
    bgClass="bg-white"
  />

  <CTABanner
    title="Find out where you stand."
    subtitle="Ten minutes, free, and nothing you enter leaves your browser. Then fill the first bucket."
    ctaText={PRIMARY_CTA_LABEL}
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Book an Athena evaluation"
    secondaryCtaHref="/athena-evaluation"
  />
</Layout>
