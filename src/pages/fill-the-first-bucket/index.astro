---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import BucketsSection from '~/components/widgets/BucketsSection.astro';
import FullWidthImageBand from '~/components/widgets/FullWidthImageBand.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getFillFirstBucketContent, getNavigationContent } from '~/lib/content';
import { cmsHeading, cmsInline, cmsParagraphsHtml } from '~/utils/cmsText';

/**
 * /fill-the-first-bucket. All copy and images come from the Sanity `fillFirstBucketPage` singleton.
 * The animated three-bucket graphic inside BucketsSection stays in code.
 */
const [page, nav] = await Promise.all([getFillFirstBucketContent(), getNavigationContent()]);
const { hero, rules, band, cta } = page;

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  {hero.image?.src && <link slot="head" rel="preload" as="image" href={hero.image.src} fetchpriority="high" />}
  <Fragment slot="header" />
  <Hero2
    variant="page"
    overlapHeader={false}
    withImage
    pageOverlay
    title={cmsInline(hero.title)}
    subtitle={cmsParagraphsHtml(hero.paragraphs)}
    image={hero.image}
    imageMobile={hero.imageMobile}
  >
    <Header slot="nav" embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
  </Hero2>

  {/* ── Three Buckets Section — Figma node 176:20 ── */}
  <BucketsSection
    pullQuote={rules.pullQuote.map((paragraph) => cmsHeading(paragraph))}
    rulesHeading={rules.heading}
    rules={rules.items}
  />

  <FullWidthImageBand imageSrc={band.image?.src} alt={band.image?.alt ?? ''} />

  {/* ── CTA Banner — Figma node 176:227 ── */}
  <CTABanner
    id="find-weakest-link"
    eyebrow={cta.eyebrow}
    title={cta.title}
    subtitle={cta.subtitle}
    ctaText={cta.ctaText}
    ctaHref={cta.ctaHref}
  />
</Layout>
