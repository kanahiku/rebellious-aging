---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import BlogCard from '~/components/ui/BlogCard.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getBlogPosts, getBlogIndexContent } from '~/lib/content';

export const prerender = false;

const [posts, page] = await Promise.all([getBlogPosts(), getBlogIndexContent()]);

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-container mx-auto">
    <h1
      class="text-h1 font-normal leading-[105%] tracking-tighter font-heading text-heading mb-[30px]"
    >
      {page.heading}
    </h1>
    {
      posts.length ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {posts.map((post) => (
            <BlogCard post={post} variant="dark" />
          ))}
        </div>
      ) : (
        <p class="text-[16px] font-normal leading-[160%] text-muted">
          {page.emptyMessage}
        </p>
      )
    }
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title={page.cta.title}
    subtitle={page.cta.subtitle}
    ctaText={page.cta.ctaText}
  />
</Layout>
