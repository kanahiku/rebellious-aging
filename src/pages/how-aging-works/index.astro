---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import ThreeBuckets from '~/components/widgets/ThreeBuckets.astro';
import AgingCurve from '~/components/widgets/AgingCurve.astro';
import ContentBand from '~/components/widgets/ContentBand.astro';
import DecadeCurve from '~/components/widgets/DecadeCurve.astro';
import ConceptSplit from '~/components/widgets/ConceptSplit.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import Text from '~/components/ui/Text.astro';
import Image from '~/components/common/Image.astro';
import { getHowAgingWorksContent, getNavigationContent } from '~/lib/content';

/**
 * /how-aging-works. All copy and images come from the Sanity `howAgingWorksPage` singleton.
 * Kept in code on purpose: <ThreeBuckets /> (diagram) and <AgingCurve /> (SVG chart + its cards).
 */
const [page, nav] = await Promise.all([getHowAgingWorksContent(), getNavigationContent()]);
const { hero, intro, buckets, blackSwan, bucketThree, decades, weStop } = page;

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};

/** Sanity asset URLs end in `-{width}x{height}.ext`; use it so remote images keep their intrinsic ratio. */
function dimensionsOf(src?: string) {
  const match = src?.match(/-(\d+)x(\d+)\.[a-z]+(?:\?|$)/i);
  return match ? { width: Number(match[1]), height: Number(match[2]) } : {};
}
const introImageSize = dimensionsOf(intro.image?.src);
const weStopImageSize = dimensionsOf(weStop.image?.src);
---

<Layout metadata={metadata}>
  {hero.image?.src && <link slot="head" rel="preload" as="image" href={hero.image.src} fetchpriority="high" />}
  <Fragment slot="header" />

  <Hero2 variant="words" overlapHeader={false} words={hero.words} image={hero.image} imageMobile={hero.imageMobile}>
    <Header slot="nav" embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
  </Hero2>

  <ConceptSplit
    heading={intro.heading}
    cta={intro.ctaText && intro.ctaHref ? { text: intro.ctaText, href: intro.ctaHref } : undefined}
    cards={intro.cards}
  >
    {intro.body.map((paragraph) => <Text>{paragraph}</Text>)}
    {
      intro.image?.src && (
        <Image
          slot="image"
          src={intro.image.src}
          alt={intro.image.alt}
          {...introImageSize}
          class="w-full rounded-[32px]"
          widths={[480, 900, 1695]}
          sizes="(max-width: 768px) 100vw, (max-width: 1280px) 60vw, 1695px"
          format="webp"
          quality={90}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </ConceptSplit>

  {/* Code-owned diagram. Only the intro text is editable. */}
  <ThreeBuckets
    id="the-buckets"
    eyebrow={buckets.eyebrow}
    heading={buckets.heading}
    body={buckets.body}
    cta={buckets.ctaText && buckets.ctaHref ? { text: buckets.ctaText, href: buckets.ctaHref } : undefined}
  />

  {/* Code-owned SVG chart + Peak/Slope/Floor/Reserve cards */}
  <AgingCurve id="aging-curve" />

  {/* Black Swan: dark band */}
  <ContentBand
    id="black-swan"
    eyebrow={blackSwan.eyebrow}
    heading={blackSwan.heading}
    paragraphs={blackSwan.paragraphs}
    cta={blackSwan.ctaText && blackSwan.ctaHref ? { text: blackSwan.ctaText, href: blackSwan.ctaHref } : undefined}
    isDark
  />

  {/* Bucket 3: white bg, no button */}
  <ContentBand
    id="bucket-3"
    eyebrow={bucketThree.eyebrow}
    heading={bucketThree.heading}
    paragraphs={bucketThree.paragraphs}
    boldNote={bucketThree.boldNote}
    bgClass="bg-white"
  />

  <DecadeCurve id="start-with-your-decade" eyebrow={decades.eyebrow} heading={decades.heading} cards={decades.cards} />

  <TextSplit heading={weStop.heading} withImage imageAspect="568 / 378.667">
    {weStop.body.map((paragraph) => <Text>{paragraph}</Text>)}
    {
      weStop.image?.src && (
        <Image
          slot="image"
          src={weStop.image.src}
          alt={weStop.image.alt}
          {...weStopImageSize}
          class="w-full rounded-[32px] object-cover"
          style="aspect-ratio: 568 / 378.667;"
          widths={[400, 568, 852]}
          sizes="(max-width: 768px) 100vw, 568px"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </TextSplit>
</Layout>
