---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import AthenaEvaluationOverview from '~/components/widgets/AthenaEvaluationOverview.astro';
import AthenaPricing from '~/components/widgets/AthenaPricing.astro';
import AthenaEvaluationBooking from '~/components/widgets/AthenaEvaluationBooking.astro';
import { getAthenaEvaluationContent, getNavigationContent } from '~/lib/content';

/** /athena-evaluation. All copy comes from the Sanity `athenaEvaluationPage` singleton. */
const [page, nav] = await Promise.all([getAthenaEvaluationContent(), getNavigationContent()]);
const { hero, overview, pricing, booking } = page;

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header" />

  <Hero2
    variant="dark-page"
    overlapHeader={false}
    tagline={hero.tagline}
    title={hero.title}
    subtitle={hero.subtitle}
    actions={[{ variant: 'primary', text: hero.ctaText, href: hero.ctaHref, target: '_blank', hideNote: true }]}
  >
    <Header slot="nav" embedded isSticky={false} links={nav.header.links} actions={nav.header.actions} />
  </Hero2>

  <AthenaEvaluationOverview
    id="what-it-is"
    eyebrow={overview.eyebrow}
    heading={overview.heading}
    intro={overview.intro}
    itemsEyebrow={overview.itemsEyebrow}
    items={overview.items}
  />

  <AthenaPricing
    id="price"
    priceEyebrow={pricing.priceEyebrow}
    price={pricing.price}
    priceNote={pricing.priceNote}
    afterEyebrow={pricing.afterEyebrow}
    afterText={pricing.afterText}
    tiers={pricing.tiers}
    perLabel={pricing.perLabel}
  />

  <AthenaEvaluationBooking
    id="own-doctor"
    heading={booking.heading}
    body={booking.body}
    listLinkText={booking.listLinkText}
    listLinkHref={booking.listLinkHref}
    disclosureEyebrow={booking.disclosureEyebrow}
    disclosureText={booking.disclosureText}
    ctaText={booking.ctaText}
    ctaHref={booking.ctaHref}
    note={booking.note}
  />
</Layout>
